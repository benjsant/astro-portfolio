---
import EmailLink from '@/components/patterns/EmailLink.astro';
import { cv } from '@/data/cv';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

function asEmailParts(value: string): { user: string; domain: string } | null {
  const m = value.match(/^([^@\s]+)@([^@\s]+)$/);
  return m ? { user: m[1], domain: m[2] } : null;
}

const photoExists = existsSync(join(process.cwd(), 'public', 'photo.jpg'));
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CV — {cv.header.name}</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      background: white;
      color: #000;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      line-height: 1.5;
    }

    main {
      background: white;
      color: black;
      max-width: 210mm;
      height: 297mm;
      margin: auto;
      padding: 12mm;
      overflow: hidden;
      font-size: 11px;
    }

    /* Header */
    .header {
      display: flex;
      gap: 16px;
      margin-bottom: 12px;
      padding-bottom: 12px;
      border-bottom: 1px solid #ddd;
    }

    .header-content {
      flex: 1;
    }

    .header h1 {
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 4px;
      line-height: 1.1;
    }

    .header .role {
      font-size: 12px;
      color: #0891b2;
      font-weight: 600;
      margin-bottom: 4px;
    }

    .header .summary {
      font-size: 10px;
      color: #666;
      line-height: 1.4;
    }

    .header img {
      width: 90px;
      height: 110px;
      object-fit: cover;
      border-radius: 6px;
      flex-shrink: 0;
    }

    /* Contact */
    .contact {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      font-size: 9px;
      margin-bottom: 10px;
      padding-bottom: 6px;
      border-bottom: 1px solid #ddd;
    }

    .contact-item {
      display: flex;
      gap: 4px;
    }

    .contact-label {
      color: #666;
    }

    .contact a {
      color: #0891b2;
      text-decoration: none;
    }

    .meta {
      font-size: 9px;
      color: #666;
    }

    /* Sections */
    section {
      margin-bottom: 8px;
      page-break-inside: avoid;
    }

    h2 {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 5px;
      text-transform: capitalize;
    }

    .section-bar {
      width: 3px;
      height: 16px;
      background: #0891b2;
      flex-shrink: 0;
    }

    /* Skills Grid */
    .skills {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px;
      font-size: 9px;
    }

    .skill-item {
      page-break-inside: avoid;
    }

    .skill-cat {
      color: #0891b2;
      font-weight: 600;
      font-size: 9px;
      margin-bottom: 2px;
    }

    .skill-val {
      color: #333;
      line-height: 1.3;
    }

    /* Projects */
    .project {
      margin-bottom: 6px;
      page-break-inside: avoid;
    }

    .project-title {
      font-weight: 600;
      color: #0891b2;
      font-size: 10px;
      margin-bottom: 1px;
    }

    .project-title a {
      color: #0891b2;
      text-decoration: none;
    }

    .project-period {
      font-size: 8px;
      color: #0891b2;
      font-weight: 600;
      margin-bottom: 1px;
    }

    .project-stack {
      font-size: 8px;
      color: #999;
      margin-bottom: 2px;
    }

    .project-desc {
      font-size: 9px;
      color: #666;
      line-height: 1.3;
    }

    /* Experience */
    .experience {
      margin-bottom: 6px;
      page-break-inside: avoid;
    }

    .exp-head {
      display: flex;
      justify-content: space-between;
      margin-bottom: 2px;
    }

    .exp-org {
      font-weight: 600;
      font-size: 10px;
    }

    .exp-role {
      color: #0891b2;
      font-weight: 600;
      font-size: 9px;
    }

    .exp-date {
      font-size: 8px;
      color: #999;
      text-align: right;
    }

    .exp-tasks {
      list-style: none;
      margin-bottom: 3px;
      padding-left: 0;
    }

    .exp-tasks li {
      font-size: 9px;
      color: #666;
      margin-bottom: 1px;
      padding-left: 8px;
      position: relative;
    }

    .exp-tasks li::before {
      content: '▸';
      position: absolute;
      left: 0;
      color: #0891b2;
    }

    .exp-stack {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      font-size: 8px;
    }

    .tag {
      background: #f0f9ff;
      color: #0891b2;
      padding: 2px 6px;
      border-radius: 3px;
      border: 0.5px solid #e0f2fe;
    }

    /* Education */
    .entry {
      display: flex;
      gap: 12px;
      margin-bottom: 4px;
      page-break-inside: avoid;
      padding-bottom: 3px;
      border-bottom: 0.5px solid #eee;
    }

    .entry-date {
      font-weight: 600;
      color: #0891b2;
      font-size: 8px;
      flex-shrink: 0;
    }

    .entry-body {
      flex: 1;
    }

    .entry-body strong {
      font-weight: 600;
      font-size: 9px;
    }

    .entry-body span {
      display: block;
      font-size: 8px;
      color: #666;
    }

    /* Interests */
    .interests {
      font-size: 9px;
      color: #666;
      line-height: 1.3;
    }

    .interests strong {
      font-weight: 600;
      color: #000;
    }

    /* Print */
    @page {
      size: A4;
      margin: 0;
    }

    @media print {
      main {
        max-width: 100%;
        height: 100%;
        margin: 0;
        padding: 10mm;
        box-shadow: none;
      }

      button {
        display: none;
      }
    }
  </style>
</head>
<body>
  <main>
    <!-- Header -->
    <div class="header">
      <div class="header-content">
        <h1>{cv.header.name}</h1>
        <p class="role">{cv.header.role}</p>
        <p class="summary">{cv.header.summary}</p>
      </div>
      {photoExists && <img src="/photo.jpg" alt={cv.header.name} />}
    </div>

    <!-- Contact -->
    <div class="contact">
      {cv.contact.map((item) => {
        const emailParts = asEmailParts(item.value);
        return (
          <div class="contact-item">
            <span class="contact-label">{item.label}:</span>
            {emailParts ? (
              <EmailLink user={emailParts.user} domain={emailParts.domain} />
            ) : item.href ? (
              <a href={item.href} target="_blank" rel="noopener noreferrer">
                {item.value}
              </a>
            ) : (
              <span>{item.value}</span>
            )}
          </div>
        );
      })}
    </div>
    <p class="meta" set:html={cv.meta} />

    <!-- Compétences -->
    <section>
      <h2>
        <div class="section-bar"></div>
        Compétences
      </h2>
      <div class="skills">
        {cv.skills.map((skill) => (
          <div class="skill-item">
            <div class="skill-cat">{skill.category}</div>
            <div class="skill-val">{skill.value}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Projets -->
    <section>
      <h2>
        <div class="section-bar"></div>
        Projets réalisés
      </h2>
      {cv.projects.map((project) => (
        <div class="project">
          <div class="project-title">
            <a href={project.repo} target="_blank" rel="noopener noreferrer">
              {project.title}
            </a>
          </div>
          {project.period && <div class="project-period">{project.period}</div>}
          <div class="project-stack">{project.stack}</div>
          <div class="project-desc">{project.description}</div>
        </div>
      ))}
    </section>

    <!-- Expériences -->
    <section>
      <h2>
        <div class="section-bar"></div>
        Expériences professionnelles
      </h2>
      {cv.experiences.map((exp) => (
        <div class="experience">
          <div class="exp-head">
            <div>
              <div class="exp-org">{exp.org}</div>
              <div class="exp-role">{exp.role}</div>
            </div>
            <div class="exp-date">{exp.date}</div>
          </div>
          <ul class="exp-tasks">
            {exp.tasks.map((task) => <li>{task}</li>)}
          </ul>
          <div class="exp-stack">
            {exp.stack.split(' · ').map((tech) => (
              <span class="tag">{tech}</span>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- Formations -->
    <section>
      <h2>
        <div class="section-bar"></div>
        Formations
      </h2>
      {cv.education.map((entry) => (
        <div class="entry">
          <div class="entry-date">{entry.date}</div>
          <div class="entry-body">
            <strong>{entry.title}</strong>
            <span>{entry.school}</span>
          </div>
        </div>
      ))}
    </section>

    <!-- Certifications -->
    <section>
      <h2>
        <div class="section-bar"></div>
        Certifications
      </h2>
      {cv.certifications.map((c) => (
        <div class="entry">
          <div class="entry-date">{c.date}</div>
          <div class="entry-body">
            <strong>{c.title}</strong>
          </div>
        </div>
      ))}
    </section>

    <!-- Centres d'intérêt -->
    <section>
      <h2>
        <div class="section-bar"></div>
        Centres d'intérêt
      </h2>
      <div class="interests">
        {cv.interests.map((i) => (
          <p>
            <strong>{i.title}</strong> — {i.description}
          </p>
        ))}
      </div>
    </section>
  </main>

  <button onclick="window.print()" style="position: fixed; top: 20px; right: 20px; padding: 8px 16px; background: #0891b2; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 12px; z-index: 1000;">
    ↓ PDF
  </button>
</body>
</html>
