---
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import CTA from '@/components/ui/marketing/CTA/CTA.astro';
import { cv } from '@/data/cv';
---

<PageLayout title="CV Design — Benjamin Santrisse" description="Curriculum vitae visuel — Développeur Backend Python (API, IA appliquée)">
  <main class="overflow-hidden">
    <!-- HERO SECTION -->
    <section class="relative min-h-screen flex items-center justify-center px-6 py-20">
      <!-- Gradient background -->
      <div class="absolute inset-0 bg-gradient-to-br from-indigo-950 via-slate-950 to-slate-900 -z-20" />
      <div class="absolute inset-0 opacity-40">
        <div class="absolute top-20 left-10 w-72 h-72 bg-indigo-500/20 rounded-full blur-3xl" />
        <div class="absolute bottom-20 right-10 w-96 h-96 bg-teal-500/10 rounded-full blur-3xl" />
      </div>

      <div class="max-w-6xl w-full grid md:grid-cols-2 gap-12 items-center relative z-10">
        <!-- Left: Text -->
        <div class="space-y-8 data-reveal">
          <div>
            <h1 class="text-6xl md:text-7xl font-display font-bold bg-gradient-to-r from-indigo-300 via-teal-200 to-cyan-300 bg-clip-text text-transparent leading-tight">
              Benjamin<br />Santrisse
            </h1>
          </div>
          <div class="space-y-3">
            <p class="text-2xl font-semibold text-teal-300">
              Développeur Backend Python
            </p>
            <p class="text-lg text-slate-300">
              Spécialisé en IA appliquée, pipelines ML et APIs haute performance
            </p>
          </div>

          <!-- Stats -->
          <div class="grid grid-cols-3 gap-6 pt-8">
            <div class="group">
              <div class="text-4xl font-bold text-indigo-300 group-hover:text-teal-300 transition-colors">
                10+
              </div>
              <div class="text-sm text-slate-400">Projets réalisés</div>
            </div>
            <div class="group">
              <div class="text-4xl font-bold text-teal-300 group-hover:text-indigo-300 transition-colors">
                7y
              </div>
              <div class="text-sm text-slate-400">Développement</div>
            </div>
            <div class="group">
              <div class="text-4xl font-bold text-cyan-300 group-hover:text-indigo-300 transition-colors">
                3y
              </div>
              <div class="text-sm text-slate-400">Focus IA</div>
            </div>
          </div>

          <!-- CTA Buttons -->
          <div class="flex gap-4 pt-4">
            <a
              href="#contact"
              class="px-8 py-3 rounded-lg bg-gradient-to-r from-indigo-500 to-teal-500 text-white font-semibold hover:shadow-lg hover:shadow-indigo-500/50 transition-all hover:scale-105"
            >
              Me contacter
            </a>
            <a
              href="/cv"
              class="px-8 py-3 rounded-lg border border-slate-600 text-slate-200 font-semibold hover:border-teal-500 hover:text-teal-300 transition-all"
            >
              CV classique
            </a>
          </div>
        </div>

        <!-- Right: Photo with gradient frame -->
        <div class="relative hidden md:flex justify-center items-center data-reveal">
          <div class="relative w-80 h-96 group">
            <!-- Glowing border -->
            <div class="absolute inset-0 bg-gradient-to-br from-indigo-500 via-teal-500 to-cyan-500 rounded-3xl opacity-75 group-hover:opacity-100 blur transition-opacity duration-300" />
            <div class="absolute inset-[2px] bg-slate-900 rounded-3xl flex items-center justify-center overflow-hidden">
              <img
                src="/photo.jpg"
                alt="Benjamin Santrisse"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- COMPÉTENCES SECTION -->
    <section class="py-24 px-6 bg-gradient-to-b from-slate-900 to-slate-950">
      <div class="max-w-6xl mx-auto">
        <div class="mb-16 text-center data-reveal">
          <h2 class="text-5xl font-display font-bold text-white mb-4">Compétences</h2>
          <p class="text-xl text-slate-400">Expertises techniques et domaines de spécialisation</p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {cv.skills.map((skill, idx) => (
            <div
              key={idx}
              class="group p-8 rounded-2xl bg-gradient-to-br from-slate-800/50 to-slate-900/30 border border-slate-700/50 hover:border-teal-500/50 transition-all duration-300 hover:shadow-lg hover:shadow-teal-500/10 data-reveal"
              style={{ transitionDelay: `${idx * 50}ms` }}
            >
              <div class="flex items-center gap-3 mb-4">
                <div class="w-2 h-8 bg-gradient-to-b from-indigo-500 to-teal-500 rounded" />
                <h3 class="text-xl font-bold text-slate-100 group-hover:text-teal-300 transition-colors">
                  {skill.category}
                </h3>
              </div>
              <p class="text-slate-300 leading-relaxed">{skill.value}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PROJETS SECTION -->
    <section class="py-24 px-6 bg-slate-950">
      <div class="max-w-6xl mx-auto">
        <div class="mb-16 text-center data-reveal">
          <h2 class="text-5xl font-display font-bold text-white mb-4">Projets</h2>
          <p class="text-xl text-slate-400">Réalisations techniques et collaborations</p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {cv.projects.map((project, idx) => (
            <div
              key={idx}
              class="group rounded-2xl overflow-hidden bg-gradient-to-br from-slate-800 to-slate-900 border border-slate-700/50 hover:border-indigo-500/50 transition-all duration-300 hover:shadow-xl hover:shadow-indigo-500/20 data-reveal"
              style={{ transitionDelay: `${idx * 50}ms` }}
            >
              <!-- Project header with gradient -->
              <div class="h-40 bg-gradient-to-br from-indigo-600/20 to-teal-600/20 relative overflow-hidden flex items-center justify-center">
                <div class="absolute inset-0 bg-gradient-to-r from-indigo-500/10 via-transparent to-teal-500/10 group-hover:from-indigo-500/20 group-hover:to-teal-500/20 transition-all" />
                <Icon name="zap" size="3xl" class="text-indigo-400/50 group-hover:text-teal-400/70 transition-colors" />
              </div>

              <div class="p-8">
                <h3 class="text-2xl font-bold text-slate-100 mb-2 group-hover:text-teal-300 transition-colors">
                  {project.title}
                </h3>
                {project.period && (
                  <p class="text-sm text-slate-400 mb-4">{project.period}</p>
                )}
                <p class="text-slate-300 mb-6 line-clamp-3">{project.description}</p>

                <!-- Tech stack -->
                <div class="flex flex-wrap gap-2 mb-6">
                  {project.stack.split(' · ').map((tech, i) => (
                    <span
                      key={i}
                      class="px-3 py-1 rounded-full text-xs font-medium bg-gradient-to-r from-indigo-500/20 to-teal-500/20 text-teal-300 border border-teal-500/30"
                    >
                      {tech}
                    </span>
                  ))}
                </div>

                <!-- Link -->
                {project.repo && (
                  <a
                    href={project.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 text-indigo-400 hover:text-teal-300 transition-colors font-semibold text-sm"
                  >
                    Voir sur GitHub <Icon name="arrow-right" size="sm" />
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- EXPÉRIENCE SECTION -->
    <section class="py-24 px-6 bg-gradient-to-b from-slate-950 to-slate-900">
      <div class="max-w-4xl mx-auto">
        <div class="mb-16 text-center data-reveal">
          <h2 class="text-5xl font-display font-bold text-white mb-4">Expérience</h2>
          <p class="text-xl text-slate-400">Parcours professionnel</p>
        </div>

        <div class="space-y-8">
          {cv.experiences.map((exp, idx) => (
            <div
              key={idx}
              class="group relative pl-8 border-l-2 border-slate-700 hover:border-teal-500 transition-all duration-300 data-reveal"
              style={{ transitionDelay: `${idx * 50}ms` }}
            >
              <!-- Timeline dot -->
              <div class="absolute -left-4 top-2 w-6 h-6 rounded-full bg-gradient-to-br from-indigo-500 to-teal-500 group-hover:shadow-lg group-hover:shadow-indigo-500/50 transition-all" />

              <!-- Content -->
              <div class="bg-gradient-to-br from-slate-800/50 to-slate-900/30 rounded-2xl p-8 border border-slate-700/30 hover:border-teal-500/30 transition-all">
                <div class="flex items-start justify-between mb-3 flex-wrap gap-4">
                  <div>
                    <h3 class="text-2xl font-bold text-slate-100 group-hover:text-teal-300 transition-colors">
                      {exp.role}
                    </h3>
                    <p class="text-teal-400 font-semibold">{exp.org}</p>
                  </div>
                  <div class="text-right text-sm text-slate-400">{exp.date}</div>
                </div>
                {exp.tasks && (
                  <ul class="space-y-2 mb-4">
                    {exp.tasks.map((task, i) => (
                      <li key={i} class="text-slate-300 text-sm flex items-start gap-3">
                        <span class="text-teal-500 mt-1">▸</span>
                        <span>{task}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {exp.stack && (
                  <div class="flex flex-wrap gap-2 pt-4 border-t border-slate-700/30">
                    {exp.stack.split(' · ').map((tech, i) => (
                      <span key={i} class="text-xs px-2 py-1 rounded bg-slate-700/50 text-slate-300">
                        {tech}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FORMATIONS SECTION -->
    <section class="py-24 px-6 bg-slate-900">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-5xl font-display font-bold text-white mb-16 text-center data-reveal">Formations</h2>

        <div class="grid md:grid-cols-3 gap-6">
          {cv.education.map((edu, idx) => (
            <div
              key={idx}
              class="group rounded-2xl p-8 bg-gradient-to-br from-indigo-600/10 to-teal-600/10 border border-slate-700/50 hover:border-indigo-500/50 transition-all duration-300 hover:shadow-lg hover:shadow-indigo-500/10 data-reveal"
              style={{ transitionDelay: `${idx * 50}ms` }}
            >
              <div class="text-4xl font-bold bg-gradient-to-r from-indigo-400 to-teal-400 bg-clip-text text-transparent mb-3">
                {edu.date}
              </div>
              <h3 class="text-xl font-bold text-slate-100 mb-2 group-hover:text-teal-300 transition-colors">
                {edu.title}
              </h3>
              <p class="text-slate-400">{edu.school}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CONTACT SECTION -->
    <section id="contact" class="py-24 px-6 bg-gradient-to-b from-slate-900 via-slate-950 to-slate-950">
      <CTA variant="brand" size="lg" maxWidth="lg" glow data-reveal>
        <h2 slot="heading" class="!text-5xl">Discutons ensemble</h2>
        <p slot="description" class="!text-xl text-balance">
          Intéressé par une collaboration ou une opportunité ? Contactez-moi pour en discuter.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          {cv.contact.map((item) => (
            item.href && (
              <a
                key={item.label}
                href={item.href}
                target={item.href.startsWith('http') ? '_blank' : undefined}
                rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg border border-slate-600 text-slate-200 font-semibold hover:border-teal-500 hover:text-teal-300 transition-all hover:shadow-lg hover:shadow-teal-500/20"
              >
                <Icon name="mail" size="sm" />
                {item.label}
              </a>
            )
          ))}
        </div>
      </CTA>
    </section>
  </main>
</PageLayout>

<style>
  [data-reveal] {
    animation: revealUp 0.8s ease-out forwards;
    opacity: 0;
  }

  @keyframes revealUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  :global(.data-reveal) {
    animation: revealUp 0.8s ease-out forwards;
    opacity: 0;
  }
</style>
