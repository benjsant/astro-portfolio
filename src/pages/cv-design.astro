---
import PageLayout from '@/layouts/PageLayout.astro';
import EmailLink from '@/components/patterns/EmailLink.astro';
import { cv } from '@/data/cv';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

function asEmailParts(value: string): { user: string; domain: string } | null {
  const m = value.match(/^([^@\s]+)@([^@\s]+)$/);
  return m ? { user: m[1], domain: m[2] } : null;
}

const photoExists = existsSync(join(process.cwd(), 'public', 'photo.jpg'));
---

<PageLayout
  title="CV Design"
  description={`Curriculum vitae de ${cv.header.name} — ${cv.header.role}. Téléchargeable en PDF.`}
>
  <main class="!bg-white !text-black min-h-screen">
    <!-- PDF Button -->
    <div class="max-w-4xl mx-auto px-4 pt-16 pb-4 flex justify-end no-print">
      <button type="button" class="px-3 py-1 text-xs rounded bg-blue-600 text-white font-semibold transition-colors" onclick="window.print()">
        ↓ PDF
      </button>
    </div>

    <!-- CV Container -->
    <div class="max-w-4xl mx-auto px-4 pb-8">
      <article class="bg-background rounded-lg border border-border p-8 md:p-12 shadow-sm">
        <!-- HEADER -->
        <header class="flex flex-col md:flex-row gap-8 md:gap-12 pb-8 border-b border-border mb-8">
          <div class="flex-1">
            <h1 class="font-display text-5xl font-bold text-foreground mb-3 leading-tight">
              {cv.header.name}
            </h1>
            <p class="text-xl font-semibold text-brand-600 mb-3">
              {cv.header.role}
            </p>
            <p class="text-foreground-secondary leading-relaxed max-w-2xl">
              {cv.header.summary}
            </p>
          </div>
          {photoExists && (
            <div class="flex-shrink-0">
              <img
                src="/photo.jpg"
                alt={cv.header.name}
                width="140"
                height="170"
                class="rounded-lg border border-border object-cover w-36 h-44"
              />
            </div>
          )}
        </header>

        <!-- CONTACT -->
        <div class="mb-8 pb-8 border-b border-border">
          <div class="flex flex-wrap gap-4 text-sm">
            {cv.contact.map((item) => {
              const emailParts = asEmailParts(item.value);
              return (
                <div class="flex items-center gap-2">
                  <span class="text-foreground-muted font-medium">{item.label}:</span>
                  {emailParts ? (
                    <EmailLink user={emailParts.user} domain={emailParts.domain} class="text-brand-600 hover:text-brand-700" />
                  ) : item.href ? (
                    <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined} class="text-brand-600 hover:text-brand-700">
                      {item.value}
                    </a>
                  ) : (
                    <span>{item.value}</span>
                  )}
                </div>
              );
            })}
          </div>
          <p class="text-sm text-foreground-secondary mt-4" set:html={cv.meta} />
        </div>

        <!-- COMPÉTENCES -->
        <section class="mb-8 pb-8 border-b border-border">
          <h2 class="font-display text-2xl font-bold text-foreground mb-6 flex items-center gap-3">
            <span class="w-1 h-8 bg-brand-600 rounded-full" />
            Compétences
          </h2>
          <div class="grid md:grid-cols-2 gap-6">
            {cv.skills.map((skill) => (
              <div class="space-y-2">
                <h3 class="font-semibold text-brand-600">{skill.category}</h3>
                <p class="text-foreground-secondary text-sm leading-relaxed">{skill.value}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- PROJETS -->
        <section class="mb-8 pb-8 border-b border-border">
          <h2 class="font-display text-2xl font-bold text-foreground mb-6 flex items-center gap-3">
            <span class="w-1 h-8 bg-brand-600 rounded-full" />
            Projets réalisés
          </h2>
          <div class="space-y-6">
            {cv.projects.map((project) => (
              <div class="p-4 rounded-lg bg-background-secondary border border-border hover:border-brand-400 transition-colors">
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-3 mb-3">
                  <h3 class="font-semibold text-lg">
                    <a href={project.repo} target="_blank" rel="noopener noreferrer" class="text-brand-600 hover:text-brand-700 underline">
                      {project.title}
                    </a>
                  </h3>
                  <span class="text-xs font-mono text-foreground-muted whitespace-nowrap">{project.stack}</span>
                </div>
                {project.period && (
                  <p class="text-xs text-brand-600 font-mono mb-2">{project.period}</p>
                )}
                <p class="text-sm text-foreground-secondary">{project.description}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- EXPÉRIENCES -->
        <section class="mb-8 pb-8 border-b border-border">
          <h2 class="font-display text-2xl font-bold text-foreground mb-6 flex items-center gap-3">
            <span class="w-1 h-8 bg-brand-600 rounded-full" />
            Expériences professionnelles
          </h2>
          <div class="space-y-6">
            {cv.experiences.map((exp) => (
              <div class="p-4 rounded-lg bg-background-secondary border border-border">
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2 mb-3">
                  <div>
                    <h3 class="font-semibold text-lg text-foreground">{exp.org}</h3>
                    <p class="text-brand-600 font-medium">{exp.role}</p>
                  </div>
                  <span class="text-sm text-foreground-muted font-mono">{exp.date}</span>
                </div>
                <ul class="space-y-1 mb-4">
                  {exp.tasks.map((task) => (
                    <li class="text-sm text-foreground-secondary flex gap-3">
                      <span class="text-brand-600 flex-shrink-0">▸</span>
                      <span>{task}</span>
                    </li>
                  ))}
                </ul>
                <div class="flex flex-wrap gap-2">
                  {exp.stack.split(' · ').map((tech) => (
                    <span class="px-2 py-1 rounded text-xs bg-brand-100/50 text-brand-700 font-mono border border-brand-200/50">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- FORMATIONS -->
        <section class="mb-8 pb-8 border-b border-border">
          <h2 class="font-display text-2xl font-bold text-foreground mb-6 flex items-center gap-3">
            <span class="w-1 h-8 bg-brand-600 rounded-full" />
            Formations
          </h2>
          <div class="space-y-3">
            {cv.education.map((entry) => (
              <div class="flex gap-6 pb-3 border-b border-border last:border-b-0">
                <span class="text-sm font-mono font-semibold text-brand-600 flex-shrink-0">{entry.date}</span>
                <div class="flex-1">
                  <p class="font-semibold text-foreground">{entry.title}</p>
                  <p class="text-sm text-foreground-secondary">{entry.school}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- CERTIFICATIONS -->
        <section class="mb-8 pb-8 border-b border-border">
          <h2 class="font-display text-2xl font-bold text-foreground mb-6 flex items-center gap-3">
            <span class="w-1 h-8 bg-brand-600 rounded-full" />
            Certifications
          </h2>
          <div class="space-y-3">
            {cv.certifications.map((cert) => (
              <div class="flex gap-6 pb-3 border-b border-border last:border-b-0">
                <span class="text-sm font-mono font-semibold text-brand-600 flex-shrink-0">{cert.date}</span>
                <p class="font-semibold text-foreground">{cert.title}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- INTÉRÊTS -->
        <section>
          <h2 class="font-display text-2xl font-bold text-foreground mb-6 flex items-center gap-3">
            <span class="w-1 h-8 bg-brand-600 rounded-full" />
            Centres d'intérêt
          </h2>
          <div class="space-y-3">
            {cv.interests.map((interest) => (
              <p class="text-foreground-secondary">
                <strong class="text-foreground font-semibold">{interest.title}</strong> — {interest.description}
              </p>
            ))}
          </div>
        </section>
      </article>
    </div>
  </main>
</PageLayout>

<style is:global>
  /* Force light mode on page */
  main {
    background-color: white !important;
    color: black !important;
  }

  /* Hide dark mode stuff */
  .dark, [data-theme] {
    color-scheme: light !important;
  }

  .no-print {
    print-color-adjust: exact !important;
  }

  @page {
    size: A4;
    margin: 10mm;
  }

  @media print {
    * {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    html, body, main {
      background: white !important;
      color: black !important;
      margin: 0 !important;
      padding: 0 !important;
      width: 100%;
    }

    .no-print {
      display: none !important;
    }

    header[data-menu-id], footer {
      display: none !important;
    }

    /* Super compact */
    article {
      padding: 0 !important;
      border: none !important;
      box-shadow: none !important;
    }

    header {
      display: flex;
      gap: 8px;
      margin-bottom: 6px;
      padding-bottom: 6px;
      border-bottom: 1px solid #ddd;
    }

    h1 {
      font-size: 18px;
      margin: 0 0 2px 0;
      line-height: 1.1;
    }

    h2 {
      font-size: 11px;
      margin: 4px 0 2px 0;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    h3, p, li {
      margin: 0;
      font-size: 9px;
      line-height: 1.2;
    }

    p { margin-bottom: 1px; }
    li { margin-bottom: 1px; margin-left: 12px; }

    section {
      margin-bottom: 4px;
      padding-bottom: 4px;
      page-break-inside: avoid;
    }

    img {
      width: 24mm;
      height: 30mm;
      object-fit: cover;
    }

    div, span {
      margin: 0;
      padding: 0;
    }

    .space-y-3 > *, .space-y-6 > * {
      margin-bottom: 1px !important;
    }

    .gap-4, .gap-6, .gap-8 {
      gap: 2px !important;
    }

    .mb-8, .pb-8 {
      margin-bottom: 2px !important;
      padding-bottom: 2px !important;
    }

    .p-4, .p-8, .md\:p-12 {
      padding: 2px !important;
    }

    .border {
      border-width: 0.5px;
      border-color: #ddd;
    }

    /* Remove all background colors except white */
    .bg-background-secondary, .bg-brand-100\\/50 {
      background: white !important;
    }
  }
</style>
