---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import EmailLink from '@/components/patterns/EmailLink.astro';
import { cv } from '@/data/cv';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

function asEmailParts(v: string) {
  const m = v.match(/^([^@\s]+)@([^@\s]+)$/);
  return m ? { user: m[1], domain: m[2] } : null;
}

const photoExists = existsSync(join(process.cwd(), 'public', 'photo.jpg'));
---

<BaseLayout
  title="CV — Benjamin Santrisse"
  description={`Curriculum vitae de ${cv.header.name} — ${cv.header.role}. Téléchargeable en PDF.`}
>
  <Header slot="header" position="fixed" shape="bar" variant="solid" size="lg" showCta={false} />

  <main class="cvd-page pt-20 pb-12">
    <div class="cvd-toolbar">
      <button class="cvd-btn" onclick="window.print()">↓ Télécharger en PDF</button>
    </div>

    <article class="cvd-sheet">

      <!-- Accent bar dégradée indigo (du CV Design) -->
      <div class="cvd-accent-bar"></div>

      <!-- Glow subtil (du CV Design) -->
      <div class="cvd-glow" aria-hidden="true"></div>

      <!-- ── HEADER ── -->
      <header class="cvd-header">
        <div class="cvd-identity">
          <!-- Nom en Outfit bold (du CV Design) -->
          <h1 class="cvd-name">{cv.header.name}</h1>
          <p class="cvd-role">{cv.header.role}</p>
          <p class="cvd-summary">{cv.header.summary}</p>

          <!-- Contact en pills (du CV Design) -->
          <div class="cvd-contact">
            {cv.contact.map((item) => {
              const ep = asEmailParts(item.value);
              return (
                <span class="cvd-pill">
                  <span class="cvd-pill-label">{item.label} :</span>{' '}
                  {ep
                    ? <EmailLink user={ep.user} domain={ep.domain} />
                    : item.href
                      ? <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">{item.value}</a>
                      : item.value}
                </span>
              );
            })}
          </div>
          <p class="cvd-meta" set:html={cv.meta} />
        </div>

        <!-- Photo avec ring gradient (du CV Design) -->
        {photoExists && (
          <div class="cvd-photo-ring">
            <img class="cvd-photo" src="/photo.jpg" alt={cv.header.name} width="92" height="112" />
          </div>
        )}
      </header>

      <!-- ── COMPÉTENCES ── -->
      <section class="cvd-section">
        <h2>Compétences</h2>
        <div class="cvd-skills">
          {cv.skills.map((s) => (
            <div class="cvd-skill-row">
              <span class="cvd-badge-cat">{s.category}</span>
              <span class="cvd-skill-val">{s.value}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- ── PROJETS ── -->
      <section class="cvd-section">
        <h2>Projets réalisés</h2>
        {cv.projects.map((p) => (
          <div class="cvd-project">
            <div class="cvd-project-head">
              <span class="cvd-project-title">
                <a href={p.repo} target="_blank" rel="noopener noreferrer">{p.title}</a>
              </span>
              <span class="cvd-stack">{p.stack}</span>
            </div>
            {p.period && <div class="cvd-period">{p.period}</div>}
            <p class="cvd-project-desc">{p.description}</p>
          </div>
        ))}
      </section>

      <!-- ── EXPÉRIENCES ── -->
      <section class="cvd-section">
        <h2>Expériences professionnelles</h2>
        {cv.experiences.map((e) => (
          <div class="cvd-exp">
            <div class="cvd-exp-head">
              <div>
                <div class="cvd-exp-org">{e.org}</div>
                <div class="cvd-exp-role">{e.role}</div>
              </div>
              <div class="cvd-exp-date">{e.date}</div>
            </div>
            <ul class="cvd-tasks">
              {e.tasks.map((t) => <li>{t}</li>)}
            </ul>
            <!-- Tags technos (du CV Design) -->
            <div class="cvd-tags">
              {e.stack.split(' · ').map((tech) => (
                <span class="cvd-tag">{tech}</span>
              ))}
            </div>
          </div>
        ))}
      </section>

      <!-- ── FORMATIONS ── -->
      <section class="cvd-section">
        <h2>Formations</h2>
        {cv.education.map((ed) => (
          <div class="cvd-entry">
            <div class="cvd-entry-date">{ed.date}</div>
            <div class="cvd-entry-body">
              <strong>{ed.title}</strong>
              <span>{ed.school}</span>
            </div>
          </div>
        ))}
      </section>

      <!-- ── CERTIFICATIONS ── -->
      <section class="cvd-section">
        <h2>Certifications</h2>
        {cv.certifications.map((c) => (
          <div class="cvd-entry">
            <div class="cvd-entry-date">{c.date}</div>
            <div class="cvd-entry-body"><strong>{c.title}</strong></div>
          </div>
        ))}
      </section>

      <!-- ── INTÉRÊTS ── -->
      <section class="cvd-section">
        <h2>Centres d'intérêt</h2>
        <div class="cvd-interests">
          {cv.interests.map((i) => (
            <p><strong>{i.title}</strong> &nbsp;—&nbsp; {i.description}</p>
          ))}
        </div>
      </section>

    </article>
  </main>
</BaseLayout>

<style is:global>

/* ══════════════════════════════════════════════════════════════
   CV DESIGN — Meilleur des 2 mondes
   Structure compacte du CV ATS + visuels du CV Design
   Palette indigo identique au /cv ATS — light mode fixé
══════════════════════════════════════════════════════════════ */

.cvd-page {
  /* Tokens indigo light (identiques à /cv ATS) */
  --bg:       oklch(100% 0 0);
  --bg-sec:   oklch(97.5% 0.010 190);
  --fg:       oklch(20% 0.01 250);
  --fg-muted: oklch(45% 0.01 250);
  --fg-sub:   oklch(60% 0.005 250);
  --border:   oklch(92% 0.006 220);

  --b50:  oklch(97%  0.02  274);
  --b100: oklch(93%  0.045 274);
  --b200: oklch(85%  0.09  274);
  --b500: oklch(53%  0.22  274);
  --b600: oklch(46%  0.21  274);
  --b700: oklch(38%  0.17  274);

  background: oklch(97% 0.012 274);
  min-height: 100vh;
  padding-left: 1rem;
  padding-right: 1rem;
  color: var(--fg);
  font-family: 'Manrope Variable', Manrope, system-ui, sans-serif;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* ── Toolbar ── */
.cvd-toolbar {
  max-width: 820px;
  margin: 0 auto 14px;
  display: flex;
  justify-content: flex-end;
}

.cvd-btn {
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #fff;
  background: var(--b600);
  border: none;
  padding: 9px 18px;
  border-radius: 7px;
  cursor: pointer;
  transition: background .2s, transform .1s;
  box-shadow: 0 1px 3px oklch(46% 0.21 274 / .20);
}
.cvd-btn:hover  { background: var(--b700); }
.cvd-btn:active { transform: translateY(1px); }

/* ── Feuille (compacité ATS + esthétique Design) ── */
.cvd-sheet {
  position: relative;
  max-width: 820px;
  margin: 0 auto;
  background: var(--bg);
  border-radius: 10px;
  border: 1px solid var(--border);
  box-shadow:
    0 1px 3px oklch(46% 0.21 274 / .08),
    0 8px 32px oklch(20% 0.05 274 / .08);
  padding: 30px 42px 24px;   /* Exactement comme le CV ATS */
  font-size: 11.5px;          /* Exactement comme le CV ATS */
  line-height: 1.4;
  overflow: hidden;
}

/* Barre dégradée indigo en haut (du CV Design) */
.cvd-accent-bar {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--b500), var(--b200));
  border-radius: 10px 10px 0 0;
}

/* Glow discret coin supérieur droit (du CV Design) */
.cvd-glow {
  position: absolute;
  top: -80px; right: -80px;
  width: 300px; height: 300px;
  background: radial-gradient(
    ellipse 80% 80% at 70% 20%,
    oklch(53% 0.22 274 / .06) 0%,
    transparent 70%
  );
  pointer-events: none;
  z-index: 0;
}

/* ── Header ── */
.cvd-header {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 0;
}

.cvd-identity { flex: 1; }

/* Outfit 800 comme le CV Design, taille proche ATS */
.cvd-name {
  font-family: 'Outfit Variable', Outfit, system-ui, sans-serif;
  font-size: 26px;
  font-weight: 800;
  letter-spacing: -0.025em;
  line-height: 1.05;
  color: var(--fg);
  margin: 0 0 4px;
}

.cvd-role {
  font-size: 13px;
  font-weight: 700;
  color: var(--b600);
  margin: 0 0 5px;
}

.cvd-summary {
  font-size: 11.5px;
  color: var(--fg-muted);
  max-width: 58ch;
  line-height: 1.45;
  margin: 0 0 7px;
}

/* Contact pills (du CV Design) */
.cvd-contact {
  display: flex;
  flex-wrap: wrap;
  gap: 3px 10px;
  margin-bottom: 4px;
}

.cvd-pill {
  display: inline-flex;
  align-items: baseline;
  gap: 3px;
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 10px;
  background: var(--b50);
  border: 1px solid var(--b100);
  border-radius: 9999px;
  padding: 1px 7px;
  color: var(--fg-muted);
}

.cvd-pill-label { color: var(--fg-sub); }

.cvd-pill a {
  color: var(--fg);
  text-decoration: none;
  border-bottom: 1px solid var(--b200);
  transition: color .15s, border-color .15s;
}
.cvd-pill a:hover { color: var(--b600); border-color: var(--b500); }

.cvd-meta { font-size: 10.5px; color: var(--fg-muted); margin: 0; }
.cvd-meta strong { color: var(--fg); font-weight: 600; }

/* Photo avec ring gradient (du CV Design) */
.cvd-photo-ring {
  position: relative;
  flex-shrink: 0;
}
.cvd-photo-ring::before {
  content: '';
  position: absolute;
  inset: -2px;
  border-radius: 9px;
  background: linear-gradient(135deg, var(--b200), var(--b500));
  z-index: 0;
}
.cvd-photo {
  position: relative;
  z-index: 1;
  width: 92px;
  height: 112px;
  object-fit: cover;
  border-radius: 7px;
  display: block;
}

/* ── Sections — titre avec dot + ligne (du CV Design) ── */
.cvd-section {
  position: relative;
  z-index: 1;
  margin-top: 11px;    /* Exactement comme le CV ATS */
}

.cvd-section h2 {
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.13em;
  color: var(--fg);
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0 0 5px;
}

/* Dot teal remplace le ■ du CV ATS */
.cvd-section h2::before {
  content: '';
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--b500);
  flex-shrink: 0;
}

/* Ligne dégradée indigo→gris (du CV Design) */
.cvd-section h2::after {
  content: '';
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, var(--b200), var(--border));
}

/* ── Compétences ── */
.cvd-skills {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 28px;
}

.cvd-skill-row {
  display: grid;
  grid-template-columns: 148px 1fr;
  gap: 4px 10px;
  font-size: 11.5px;
  padding: 2px 0;
  border-bottom: 1px solid var(--b50);
  align-items: start;
}
.cvd-skill-row:last-child { border-bottom: none; }

/* Badge catégorie (du CV Design) */
.cvd-badge-cat {
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 9.5px;
  font-weight: 700;
  color: var(--b600);
  background: oklch(53% 0.22 274 / .07);
  border: 1px solid oklch(53% 0.22 274 / .18);
  border-radius: 4px;
  padding: 1px 5px;
  white-space: nowrap;
  align-self: start;
  margin-top: 1px;
}

.cvd-skill-val { color: var(--fg); font-size: 11px; }

/* ── Projets ── */
.cvd-project { margin-bottom: 7px; }
.cvd-project:last-child { margin-bottom: 0; }

.cvd-project-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12px;
  flex-wrap: wrap;
}

.cvd-project-title {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--fg);
}
.cvd-project-title a {
  color: inherit;
  text-decoration: none;
  border-bottom: 1.5px solid var(--b500);
  transition: color .15s;
}
.cvd-project-title a:hover { color: var(--b600); }

.cvd-stack {
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 9.5px;
  color: var(--fg-muted);
}

.cvd-period {
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 9.5px;
  font-weight: 700;
  color: var(--b600);
  margin: 1px 0;
}

.cvd-project-desc {
  font-size: 11px;
  color: var(--fg-muted);
  line-height: 1.45;
  margin: 2px 0 0;
}

/* ── Expériences ── */
.cvd-exp { margin-bottom: 4px; }

.cvd-exp-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12px;
  flex-wrap: wrap;
}

.cvd-exp-org  { font-size: 12.5px; font-weight: 600; color: var(--fg); }
.cvd-exp-role { font-size: 11.5px; color: var(--b600); font-weight: 500; }
.cvd-exp-date {
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 9.5px;
  color: var(--fg-muted);
  text-align: right;
}

.cvd-tasks {
  list-style: none;
  padding: 0;
  margin: 4px 0;
}
.cvd-tasks li {
  position: relative;
  padding-left: 14px;
  font-size: 11px;
  color: var(--fg-muted);
  line-height: 1.35;
  margin-bottom: 1px;
}
.cvd-tasks li::before {
  content: "▸";
  position: absolute;
  left: 0;
  color: var(--b500);
  font-size: 10px;
}

/* Tags technos (du CV Design) */
.cvd-tags { display: flex; flex-wrap: wrap; gap: 3px; }

.cvd-tag {
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 9px;
  font-weight: 600;
  color: var(--b700);
  background: var(--b50);
  border: 1px solid var(--b100);
  padding: 1px 6px;
  border-radius: 4px;
}

/* ── Formations / Certifications ── */
.cvd-entry {
  display: grid;
  grid-template-columns: 80px 1fr;
  gap: 10px;
  font-size: 11.5px;
  padding: 2px 0;
  border-bottom: 1px solid var(--b100);
}
.cvd-entry:last-child { border-bottom: none; }

.cvd-entry-date {
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 10px;
  color: var(--b600);
  font-weight: 700;
  padding-top: 1px;
}

.cvd-entry-body strong { color: var(--fg); font-weight: 600; display: block; }
.cvd-entry-body span { color: var(--fg-muted); font-size: 10.5px; }

/* ── Intérêts ── */
.cvd-interests { font-size: 11px; color: var(--fg-muted); }
.cvd-interests p { margin: 1px 0; }
.cvd-interests strong {
  color: var(--fg);
  font-weight: 600;
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 10px;
}

/* ════════════════════════════════════════════════════════════
   PRINT — 1 page A4
════════════════════════════════════════════════════════════ */
@page { size: A4; margin: 0; }

@media print {
  *, *::before, *::after {
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }

  html, body { background: #fff !important; }

  .cvd-page {
    --b50:  #eef2ff !important;
    --b100: #e0e7ff !important;
    --b200: #c7d2fe !important;
    --b500: #4f46e5 !important;
    --b600: #4338ca !important;
    --b700: #3730a3 !important;
    --fg:       #1a2228 !important;
    --fg-muted: #5a6670 !important;
    --fg-sub:   #8a949c !important;
    --border:   #e3e8eb !important;
  }

  header[data-menu-id], footer, .cvd-toolbar { display: none !important; }

  .cvd-page { background: #fff !important; padding: 0; min-height: 0; }

  .cvd-sheet {
    max-width: none;
    width: 100%;
    margin: 0;
    padding: 9mm 12mm 8mm !important;
    box-shadow: none !important;
    border: none !important;
    border-radius: 0 !important;
  }

  .cvd-accent-bar { display: none; }
  .cvd-glow       { display: none; }

  .cvd-section h2::before { background: #4f46e5 !important; }
  .cvd-section h2::after  { background: linear-gradient(90deg, #c7d2fe, #e3e8eb) !important; }
  .cvd-tasks li::before   { color: #4f46e5 !important; }

  .cvd-section, .cvd-project, .cvd-exp-head,
  .cvd-entry, .cvd-tasks li { page-break-inside: avoid; }
}
</style>
