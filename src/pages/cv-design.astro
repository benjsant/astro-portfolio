---
import PageLayout from '@/layouts/PageLayout.astro';
import EmailLink from '@/components/patterns/EmailLink.astro';
import { cv } from '@/data/cv';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

function asEmailParts(value: string): { user: string; domain: string } | null {
  const m = value.match(/^([^@\s]+)@([^@\s]+)$/);
  return m ? { user: m[1], domain: m[2] } : null;
}

const photoExists = existsSync(join(process.cwd(), 'public', 'photo.jpg'));
---

<PageLayout
  title="CV Design — Benjamin Santrisse"
  description={`Curriculum vitae de ${cv.header.name} — ${cv.header.role}. Téléchargeable en PDF.`}
>
  <div class="cv-light-wrapper">
    <!-- Toolbar -->
    <div class="cv-toolbar no-print">
      <button type="button" class="cv-btn" onclick="window.print()">
        ↓ Télécharger en PDF
      </button>
    </div>

    <!-- PAGE 1 -->
    <div class="cv-page">
      <article class="cv-sheet">

        <!-- HEADER -->
        <header class="cv-header">
          <div class="cv-identity">
            <h1 class="cv-name">{cv.header.name}</h1>
            <p class="cv-role">{cv.header.role}</p>
            <p class="cv-summary">{cv.header.summary}</p>

            <!-- CONTACT inline -->
            <div class="cv-contact">
              {cv.contact.map((item) => {
                const emailParts = asEmailParts(item.value);
                return (
                  <span class="cv-contact-item">
                    <span class="cv-label">{item.label} :</span>{' '}
                    {emailParts ? (
                      <EmailLink user={emailParts.user} domain={emailParts.domain} />
                    ) : item.href ? (
                      <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
                        {item.value}
                      </a>
                    ) : (
                      item.value
                    )}
                  </span>
                );
              })}
            </div>
            <p class="cv-meta" set:html={cv.meta} />
          </div>
          {photoExists && (
            <img class="cv-photo" src="/photo.jpg" alt={cv.header.name} />
          )}
        </header>

        <!-- COMPÉTENCES — grille 2 colonnes -->
        <section class="cv-section">
          <h2 class="cv-section-title">Compétences</h2>
          <div class="cv-skills-grid">
            {cv.skills.map((skill) => (
              <div class="cv-skill-card">
                <div class="cv-skill-cat">{skill.category}</div>
                <div class="cv-skill-val">{skill.value}</div>
              </div>
            ))}
          </div>
        </section>

        <!-- PROJETS -->
        <section class="cv-section">
          <h2 class="cv-section-title">Projets réalisés</h2>
          <div class="cv-projects">
            {cv.projects.map((project) => (
              <div class="cv-project-card">
                <div class="cv-project-top">
                  <div class="cv-project-title">
                    <a href={project.repo} target="_blank" rel="noopener noreferrer">
                      {project.title}
                    </a>
                  </div>
                  <div class="cv-stack">{project.stack}</div>
                </div>
                {project.period && <div class="cv-period">{project.period}</div>}
                <p class="cv-project-desc">{project.description}</p>
              </div>
            ))}
          </div>
        </section>

      </article>
    </div>

    <!-- PAGE 2 -->
    <div class="cv-page">
      <article class="cv-sheet">

        <!-- EXPÉRIENCES -->
        <section class="cv-section">
          <h2 class="cv-section-title">Expériences professionnelles</h2>
          {cv.experiences.map((exp) => (
            <div class="cv-exp-card">
              <div class="cv-exp-head">
                <div>
                  <div class="cv-exp-org">{exp.org}</div>
                  <div class="cv-exp-role">{exp.role}</div>
                </div>
                <div class="cv-exp-date">{exp.date}</div>
              </div>
              <ul class="cv-tasks">
                {exp.tasks.map((t) => <li>{t}</li>)}
              </ul>
              <div class="cv-tags">
                {exp.stack.split(' · ').map((tech) => (
                  <span class="cv-tag">{tech}</span>
                ))}
              </div>
            </div>
          ))}
        </section>

        <!-- FORMATIONS -->
        <section class="cv-section">
          <h2 class="cv-section-title">Formations</h2>
          <div class="cv-entries">
            {cv.education.map((entry) => (
              <div class="cv-entry">
                <div class="cv-entry-date">{entry.date}</div>
                <div class="cv-entry-body">
                  <strong>{entry.title}</strong>
                  <span>{entry.school}</span>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- CERTIFICATIONS -->
        <section class="cv-section">
          <h2 class="cv-section-title">Certifications</h2>
          <div class="cv-entries">
            {cv.certifications.map((c) => (
              <div class="cv-entry">
                <div class="cv-entry-date">{c.date}</div>
                <div class="cv-entry-body">
                  <strong>{c.title}</strong>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- INTÉRÊTS -->
        <section class="cv-section">
          <h2 class="cv-section-title">Centres d'intérêt</h2>
          <div class="cv-interests">
            {cv.interests.map((i) => (
              <p><strong>{i.title}</strong> &nbsp;—&nbsp; {i.description}</p>
            ))}
          </div>
        </section>

      </article>
    </div>

  </div>
</PageLayout>

<style is:global>
  /* ─── Force light mode sur toute la page ─── */
  .cv-light-wrapper {
    background: oklch(97.5% 0.010 190);
    min-height: 100vh;
    padding-top: 5rem;
    padding-bottom: 3rem;
    padding-left: 1rem;
    padding-right: 1rem;
    color-scheme: light;
  }

  /* ─── Toolbar ─── */
  .cv-toolbar {
    max-width: 820px;
    margin: 0 auto 1rem;
    display: flex;
    justify-content: flex-end;
  }

  .cv-btn {
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: white;
    background: oklch(53% 0.22 274);
    border: none;
    padding: 10px 20px;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
  }
  .cv-btn:hover { background: oklch(46% 0.21 274); }
  .cv-btn:active { transform: translateY(1px); }

  /* ─── Page (feuille blanche sur fond gris) ─── */
  .cv-page {
    max-width: 820px;
    margin: 0 auto 2.5rem;
  }

  .cv-sheet {
    background: white;
    border-radius: 12px;
    border: 1px solid oklch(92% 0.006 220);
    box-shadow:
      0 1px 3px oklch(20% 0.01 250 / 0.06),
      0 8px 32px oklch(20% 0.01 250 / 0.08),
      0 0 0 1px oklch(92% 0.006 220 / 0.5);
    padding: 2.5rem 3rem;
    color: oklch(20% 0.01 250);
    font-family: 'Manrope Variable', Manrope, system-ui, sans-serif;
    font-size: 13px;
    line-height: 1.55;
  }

  /* ─── Header ─── */
  .cv-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid oklch(92% 0.006 220);
    margin-bottom: 1.5rem;
  }

  .cv-identity { flex: 1; }

  .cv-name {
    font-family: 'Outfit Variable', Outfit, system-ui, sans-serif;
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: oklch(20% 0.01 250);
    margin: 0 0 0.25rem;
    line-height: 1.1;
  }

  .cv-role {
    font-size: 1rem;
    font-weight: 600;
    color: oklch(46% 0.21 274);
    margin: 0 0 0.5rem;
  }

  .cv-summary {
    font-size: 0.8125rem;
    color: oklch(45% 0.01 250);
    max-width: 55ch;
    line-height: 1.5;
    margin: 0 0 0.75rem;
  }

  .cv-photo {
    width: 90px;
    height: 110px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid oklch(92% 0.006 220);
    flex-shrink: 0;
  }

  /* ─── Contact ─── */
  .cv-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 1rem;
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.7rem;
    color: oklch(45% 0.01 250);
    margin-bottom: 0.3rem;
  }

  .cv-contact-item { display: flex; gap: 0.25rem; align-items: baseline; }
  .cv-label { color: oklch(60% 0.005 250); }

  .cv-contact a {
    color: oklch(46% 0.21 274);
    text-decoration: none;
    border-bottom: 1px solid oklch(93% 0.045 274);
  }
  .cv-contact a:hover { border-color: oklch(46% 0.21 274); }

  .cv-meta {
    font-size: 0.7rem;
    color: oklch(45% 0.01 250);
    margin: 0;
  }
  .cv-meta strong { color: oklch(20% 0.01 250); font-weight: 600; }

  /* ─── Sections ─── */
  .cv-section {
    margin-bottom: 1.5rem;
  }

  .cv-section-title {
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: oklch(20% 0.01 250);
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0 0 0.875rem;
  }

  .cv-section-title::before {
    content: "■";
    color: oklch(53% 0.22 274);
    font-size: 0.625rem;
  }

  .cv-section-title::after {
    content: "";
    flex: 1;
    height: 1px;
    background: oklch(92% 0.006 220);
  }

  /* ─── Skills — 2 colonnes ─── */
  .cv-skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 2rem;
  }

  .cv-skill-card {
    padding: 0.5rem 0;
    border-bottom: 1px solid oklch(97% 0.02 274);
  }

  .cv-skill-cat {
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.65rem;
    font-weight: 700;
    color: oklch(46% 0.21 274);
    margin-bottom: 0.125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .cv-skill-val {
    font-size: 0.75rem;
    color: oklch(30% 0.01 250);
    line-height: 1.4;
  }

  /* ─── Projets ─── */
  .cv-projects { display: flex; flex-direction: column; gap: 0.875rem; }

  .cv-project-card {
    padding: 0.75rem 1rem;
    border-radius: 8px;
    border: 1px solid oklch(92% 0.006 220);
    background: oklch(99% 0.005 220);
  }

  .cv-project-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.2rem;
  }

  .cv-project-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: oklch(20% 0.01 250);
  }

  .cv-project-title a {
    color: oklch(46% 0.21 274);
    text-decoration: none;
    border-bottom: 1.5px solid oklch(53% 0.22 274);
  }
  .cv-project-title a:hover { color: oklch(38% 0.17 274); }

  .cv-stack {
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.6rem;
    color: oklch(55% 0.008 250);
  }

  .cv-period {
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.65rem;
    font-weight: 700;
    color: oklch(46% 0.21 274);
    margin-bottom: 0.2rem;
  }

  .cv-project-desc {
    font-size: 0.75rem;
    color: oklch(40% 0.01 250);
    line-height: 1.45;
    margin: 0;
  }

  /* ─── Expériences ─── */
  .cv-exp-card {
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid oklch(94% 0.006 220);
  }
  .cv-exp-card:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }

  .cv-exp-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .cv-exp-org {
    font-size: 0.9375rem;
    font-weight: 700;
    color: oklch(20% 0.01 250);
  }

  .cv-exp-role {
    font-size: 0.8125rem;
    font-weight: 600;
    color: oklch(46% 0.21 274);
  }

  .cv-exp-date {
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.65rem;
    color: oklch(55% 0.008 250);
    white-space: nowrap;
    padding-top: 0.15rem;
  }

  .cv-tasks {
    list-style: none;
    padding: 0;
    margin: 0.375rem 0 0.5rem;
  }

  .cv-tasks li {
    position: relative;
    padding-left: 1rem;
    font-size: 0.8rem;
    color: oklch(40% 0.01 250);
    line-height: 1.45;
    margin-bottom: 0.1rem;
  }

  .cv-tasks li::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: oklch(53% 0.22 274);
    font-size: 0.65rem;
    top: 0.15rem;
  }

  .cv-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .cv-tag {
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.6rem;
    font-weight: 600;
    color: oklch(38% 0.17 274);
    background: oklch(97% 0.02 274);
    border: 1px solid oklch(93% 0.045 274);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  /* ─── Formations / Certifications ─── */
  .cv-entries { display: flex; flex-direction: column; gap: 0.375rem; }

  .cv-entry {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
    font-size: 0.8125rem;
    padding-bottom: 0.375rem;
    border-bottom: 1px solid oklch(97% 0.02 274);
  }
  .cv-entry:last-child { border-bottom: none; padding-bottom: 0; }

  .cv-entry-date {
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.7rem;
    font-weight: 700;
    color: oklch(46% 0.21 274);
    padding-top: 0.1rem;
  }

  .cv-entry-body strong { display: block; color: oklch(20% 0.01 250); font-weight: 600; }
  .cv-entry-body span { color: oklch(45% 0.01 250); font-size: 0.75rem; }

  /* ─── Intérêts ─── */
  .cv-interests { display: flex; flex-direction: column; gap: 0.2rem; }

  .cv-interests p {
    font-size: 0.8125rem;
    color: oklch(40% 0.01 250);
    margin: 0;
  }

  .cv-interests strong {
    font-weight: 600;
    color: oklch(20% 0.01 250);
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.7rem;
  }

  /* ─── Print ─── */
  @page { size: A4; margin: 0; }

  @media print {
    *, *::before, *::after {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    html, body { background: white !important; }

    .no-print { display: none !important; }

    header[data-menu-id], footer { display: none !important; }

    .cv-light-wrapper {
      background: oklch(97.5% 0.010 190) !important;
      padding: 0 !important;
    }

    .cv-page {
      max-width: 100%;
      margin: 0;
    }

    .cv-sheet {
      border-radius: 0 !important;
      border: none !important;
      box-shadow: none !important;
      padding: 12mm 14mm !important;
      page-break-after: always;
    }

    .cv-sheet:last-child { page-break-after: auto; }

    /* Hex fallback pour indigo en print */
    .cv-light-wrapper {
      --cv-brand: #4338ca;
      --cv-brand-light: #4f46e5;
    }
  }
</style>
