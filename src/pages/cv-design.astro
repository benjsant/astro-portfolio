---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import CvContactValue from '@/components/patterns/CvContactValue.astro';
import { cv } from '@/data/cv';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

const photoExists = existsSync(join(process.cwd(), 'public', 'photo.jpg'));

// Icônes par canal (remplacent les labels texte dans les pills)
const contactIcons: Record<string, string> = {
  Mail: 'mail',
  Portfolio: 'external-link',
  LinkedIn: 'brand-linkedin',
  GitHub: 'brand-github',
};

// Sur le CV design, l'icône indique déjà la plateforme : on affiche un handle
// court dans les pills (LinkedIn/GitHub sans le domaine) pour rester compact.
// Le lien (href) reste complet, et le CV ATS garde l'URL entière (utile à l'impression).
const pillContact = cv.contact.map((item) => ({
  ...item,
  value: item.value
    .replace(/^https?:\/\//, '')
    .replace(/^linkedin\.com\/in\//, '')
    .replace(/^github\.com\//, ''),
}));
---

<BaseLayout
  title="CV_Dev_IA_Benjamin_Santrisse"
  titleAsIs
  description={`Curriculum vitae de ${cv.header.name} – ${cv.header.role}. Téléchargeable en PDF.`}
>
  <Header slot="header" position="fixed" shape="bar" variant="solid" size="lg" showCta={false} />

  <div class="cvd-root">

    <div class="cvd-toolbar no-print">
      <button class="cvd-btn" onclick="window.print()">↓ Télécharger en PDF</button>
    </div>

    <main class="cvd-paper" role="main">

      <!-- ════ HERO BAND (indigo plein) ════ -->
      <header class="cvd-hero">
        <div class="cvd-hero-text">
          <div class="cvd-status">
            <span class="cvd-status-dot"></span>
            Disponible · démarrage immédiat
          </div>
          <h1 class="cvd-name">{cv.header.name}</h1>
          <p class="cvd-role">{cv.header.role}</p>
          <p class="cvd-summary">{cv.header.summary}</p>

          <div class="cvd-pills">
            {pillContact.map((item) => (
              <span class="cvd-pill">
                <Icon name={contactIcons[item.label] ?? 'link'} size="xs" class="cvd-pill-icon" />
                <CvContactValue item={item} linkClass="cvd-pill-link" />
              </span>
            ))}
          </div>
          <div class="cvd-pills cvd-pills-info">
            {cv.details
              .filter((d) => d.label !== 'Recherche')
              .map((d) => (
                <span class="cvd-pill">
                  <span class="cvd-pill-label">{d.label} :</span>
                  <span class="cvd-pill-link">{d.value}</span>
                </span>
              ))}
          </div>
        </div>

        {photoExists && (
          <div class="cvd-photo-wrap">
            <img class="cvd-photo" src="/photo.jpg" alt={cv.header.name} width="96" height="116" />
          </div>
        )}
      </header>

      <!-- ════ BODY (fond clair) ════ -->
      <div class="cvd-body">

        <!-- COMPÉTENCES -->
        <section class="cvd-section">
          <h2 class="cvd-h2"><span class="cvd-dot"></span>Compétences</h2>
          <div class="cvd-skills">
            {cv.skills.map((s) => (
              <div class="cvd-skill-row">
                <span class="cvd-badge-cat">{s.category}</span>
                <span class="cvd-skill-val">{s.value}</span>
              </div>
            ))}
          </div>
        </section>

        <!-- PROJETS -->
        <section class="cvd-section">
          <h2 class="cvd-h2"><span class="cvd-dot"></span>Projets réalisés</h2>
          {cv.projects.map((p) => (
            <div class="cvd-project">
              <div class="cvd-proj-top">
                <span class="cvd-proj-name">
                  <a href={p.repo} target="_blank" rel="noopener noreferrer">{p.title}</a>
                </span>
                {p.period && <span class="cvd-proj-period">{p.period}</span>}
              </div>
              <p class="cvd-proj-stack">{p.stack}</p>
              <p class="cvd-proj-desc">{p.description}</p>
            </div>
          ))}
        </section>

        <!-- EXPÉRIENCES — timeline -->
        <section class="cvd-section">
          <h2 class="cvd-h2"><span class="cvd-dot"></span>Expériences professionnelles</h2>
          <div class="cvd-timeline">
            {cv.experiences.map((e) => (
              <div class="cvd-tl-item">
                <div class="cvd-tl-head">
                  <div>
                    <span class="cvd-tl-org">{e.org}</span>
                    <span class="cvd-tl-role">{e.role}</span>
                  </div>
                  <span class="cvd-tl-date">{e.date}</span>
                </div>
                <ul class="cvd-tasks">
                  {e.tasks.map((t) => <li>{t}</li>)}
                </ul>
                <div class="cvd-tags">
                  {e.stack.split(' · ').map((tech) => <span class="cvd-tag">{tech}</span>)}
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- FORMATIONS — timeline -->
        <section class="cvd-section">
          <h2 class="cvd-h2"><span class="cvd-dot"></span>Formations</h2>
          <div class="cvd-timeline">
            {cv.education.map((ed) => (
              <div class="cvd-tl-item cvd-tl-compact">
                <div class="cvd-tl-head">
                  <div>
                    <span class="cvd-tl-org">{ed.title}</span>
                    <span class="cvd-tl-role">{ed.school}</span>
                  </div>
                  <span class="cvd-tl-date">{ed.date}</span>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- CERTIFICATIONS -->
        <section class="cvd-section">
          <h2 class="cvd-h2"><span class="cvd-dot"></span>Certifications</h2>
          {cv.certifications.map((c) => (
            <p class="cvd-mini">
              <span class="cvd-mini-date">{c.date}</span>
              <strong>{c.title}</strong>
            </p>
          ))}
        </section>

        <!-- CENTRES D'INTÉRÊT -->
        <section class="cvd-section">
          <h2 class="cvd-h2"><span class="cvd-dot"></span>Centres d'intérêt</h2>
          {cv.interests.map((i) => (
            <p class="cvd-mini">
              <strong>{i.title}</strong> – {i.description}
            </p>
          ))}
        </section>

      </div>
    </main>
  </div>
</BaseLayout>

<style is:global>

/* ══════════════════════════════════════════════════════════════
   CV DESIGN — Hero indigo plein + timeline. Light mode, 1 page A4.
══════════════════════════════════════════════════════════════ */

.cvd-root {
  --bg:       oklch(100% 0 0);
  --fg:       oklch(18% 0.01 250);
  --fg-muted: oklch(36% 0.01 250);
  --fg-sub:   oklch(46% 0.008 250);
  --border:   oklch(90% 0.006 220);

  --b50:  oklch(97% 0.02  274);
  --b100: oklch(93% 0.045 274);
  --b200: oklch(85% 0.09  274);
  --b300: oklch(75% 0.14  274);
  --b500: oklch(53% 0.22  274);
  --b600: oklch(46% 0.21  274);
  --b700: oklch(38% 0.17  274);

  background: oklch(97% 0.012 274);
  min-height: 100vh;
  padding: 5rem 1rem 3rem;
  font-family: 'Manrope Variable', Manrope, system-ui, sans-serif;
  color: var(--fg);
  -webkit-font-smoothing: antialiased;
  color-scheme: light;
}

/* ── Toolbar ── */
.cvd-toolbar { max-width: 820px; margin: 0 auto 14px; display: flex; justify-content: flex-end; }
.cvd-btn {
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
  color: #fff; background: var(--b600); border: none; padding: 9px 18px;
  border-radius: 7px; cursor: pointer; transition: background .2s, transform .1s;
  box-shadow: 0 1px 3px oklch(46% 0.21 274 / .20);
}
.cvd-btn:hover { background: var(--b700); }
.cvd-btn:active { transform: translateY(1px); }

/* ── Feuille ── */
.cvd-paper {
  position: relative;
  max-width: 820px;
  margin: 0 auto;
  background: var(--bg);
  border-radius: 12px;
  border: 1px solid var(--border);
  box-shadow: 0 8px 32px oklch(20% 0.05 274 / .10);
  overflow: hidden;
}

/* ════ HERO BAND indigo ════ */
.cvd-hero {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24px;
  margin: 16px 16px 4px;
  padding: 16px 22px;
  background: var(--b50);
  color: var(--fg);
  border: 2px solid var(--b500);
  border-radius: 10px;
  overflow: hidden;
}

/* Plus de halo : on évite les aplats (encre + plantages d'impression) */
.cvd-hero::after { display: none; }

.cvd-hero-text { position: relative; z-index: 1; flex: 1; }

.cvd-name {
  font-family: 'Outfit Variable', Outfit, system-ui, sans-serif;
  font-size: 30px;
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.05;
  color: var(--b700);
  margin: 0 0 4px;
}

.cvd-role {
  font-size: 13.5px;
  font-weight: 700;
  color: var(--b600);
  margin: 0 0 7px;
}

.cvd-summary {
  font-size: 11px;
  color: var(--fg-muted);
  max-width: 60ch;
  line-height: 1.5;
  margin: 0 0 9px;
}

/* Pills contact translucides sur l'indigo */
.cvd-pills { display: flex; flex-wrap: wrap; gap: 4px 5px; margin-bottom: 5px; }
.cvd-pill {
  display: inline-flex; align-items: baseline; gap: 3px;
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 8.5px;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 9999px;
  padding: 2px 7px;
}
.cvd-pill-label { color: var(--fg-muted); }
.cvd-pill-link {
  color: var(--b700) !important;
  text-decoration: none;
  border-bottom: none !important;
  font-weight: 600;
}
.cvd-pill-link:hover { color: var(--b600) !important; }

/* Icône dans les pills (remplace le label texte) */
.cvd-pill { align-items: center; }
.cvd-pill-icon { width: 11px; height: 11px; color: var(--b600); flex-shrink: 0; }

.cvd-pills-info { margin-top: 2px; }

/* Badge "Disponible" */
.cvd-status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--b700);
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 9999px;
  padding: 2px 10px;
  margin-bottom: 8px;
}
.cvd-status-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: #34d399;
  box-shadow: 0 0 0 3px rgb(52 211 153 / .25);
}

/* Photo avec ring blanc */
.cvd-photo-wrap { position: relative; z-index: 1; flex-shrink: 0; }
.cvd-photo {
  width: 96px;
  height: 116px;
  object-fit: cover;
  border-radius: 9px;
  display: block;
  border: 2px solid var(--b500);
  box-shadow: 0 2px 8px rgb(0 0 0 / .12);
}

/* ════ BODY ════ */
.cvd-body { padding: 18px 38px 24px; }

.cvd-section { margin-bottom: 12px; }
.cvd-section:last-child { margin-bottom: 0; }

.cvd-h2 {
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 10.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--b600);
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0 0 7px;
}
.cvd-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--b500); flex-shrink: 0;
}
.cvd-h2::after {
  content: ''; flex: 1; height: 2px; border-radius: 2px;
  background: linear-gradient(90deg, var(--b200), transparent);
}

/* ── Compétences — 1 colonne (comme le CV ATS) ── */
.cvd-skills { display: flex; flex-direction: column; }
.cvd-skill-row {
  display: grid; grid-template-columns: 150px 1fr; gap: 4px 14px;
  font-size: 11px; padding: 2.5px 0;
  border-bottom: 1px solid var(--b50);
  align-items: center;
}
.cvd-skill-row:last-child { border-bottom: none; }
.cvd-badge-cat {
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 9px; font-weight: 700; color: var(--b600);
  background: oklch(53% 0.22 274 / .08);
  border: 1px solid oklch(53% 0.22 274 / .18);
  border-radius: 4px; padding: 1px 5px;
  white-space: nowrap; justify-self: start;
}
.cvd-skill-val { color: var(--fg); }

/* ── Projets ── */
.cvd-project { margin-bottom: 7px; }
.cvd-project:last-child { margin-bottom: 0; }
.cvd-proj-top { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
.cvd-proj-name { font-size: 12px; font-weight: 700; color: var(--fg); }
.cvd-proj-name a {
  color: var(--b600); text-decoration: none;
  border-bottom: 1.5px solid var(--b300); transition: color .15s, border-color .15s;
}
.cvd-proj-name a:hover { color: var(--b700); border-color: var(--b500); }
.cvd-proj-period {
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 8.5px; font-weight: 700; color: var(--b600);
  background: oklch(53% 0.22 274 / .08);
  border: 1px solid oklch(53% 0.22 274 / .18);
  border-radius: 4px; padding: 1px 6px; white-space: nowrap;
}
.cvd-proj-stack {
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 8.5px; color: var(--fg-sub); margin: 1px 0 2px;
}
.cvd-proj-desc { font-size: 10.5px; color: var(--fg-muted); line-height: 1.4; margin: 0; }

/* ── Timeline (expériences / formations) ── */
.cvd-timeline { position: relative; padding-left: 16px; }
.cvd-timeline::before {
  content: ''; position: absolute;
  left: 3px; top: 4px; bottom: 4px;
  width: 2px; border-radius: 2px;
  background: linear-gradient(180deg, var(--b400, var(--b300)), var(--b200));
}
.cvd-tl-item { position: relative; margin-bottom: 9px; }
.cvd-tl-item:last-child { margin-bottom: 0; }
.cvd-tl-item::before {
  content: ''; position: absolute;
  left: -16px; top: 3px;
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--b500);
  border: 2px solid var(--bg);
  box-shadow: 0 0 0 1.5px var(--b300);
}
.cvd-tl-compact { margin-bottom: 5px; }

.cvd-tl-head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
.cvd-tl-org { display: block; font-size: 12px; font-weight: 700; color: var(--fg); }
.cvd-tl-role { display: block; font-size: 11px; font-weight: 500; color: var(--b600); }
.cvd-tl-date {
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 8.5px; font-weight: 700; color: var(--b600); white-space: nowrap;
  background: oklch(53% 0.22 274 / .08);
  border: 1px solid oklch(53% 0.22 274 / .18);
  border-radius: 4px; padding: 1px 6px;
  align-self: flex-start;
}

.cvd-tasks { list-style: none; padding: 0; margin: 3px 0; }
.cvd-tasks li {
  position: relative; padding-left: 13px;
  font-size: 10.5px; color: var(--fg-muted); line-height: 1.35; margin-bottom: 1px;
}
.cvd-tasks li::before { content: "▸"; position: absolute; left: 0; color: var(--b500); font-size: 9px; top: .12em; }

.cvd-tags { display: flex; flex-wrap: wrap; gap: 3px; margin-top: 2px; }
.cvd-tag {
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 8.5px; font-weight: 600; color: var(--b700);
  background: var(--b50); border: 1px solid var(--b100);
  padding: 1px 6px; border-radius: 4px;
}

/* ── Certif + intérêts (2 colonnes) ── */
.cvd-mini { font-size: 10.5px; color: var(--fg-muted); margin: 0 0 3px; line-height: 1.4; }
.cvd-mini:last-child { margin-bottom: 0; }
.cvd-mini strong { color: var(--fg); font-weight: 600; }
.cvd-mini-date {
  display: inline-block;
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 8.5px; font-weight: 700; color: var(--b600); margin-right: 6px;
  background: oklch(53% 0.22 274 / .08);
  border: 1px solid oklch(53% 0.22 274 / .18);
  border-radius: 4px; padding: 1px 6px;
}

/* ════════════════════════════════════════════════════════════
   PRINT — 1 page A4
════════════════════════════════════════════════════════════ */
@page { size: A4; margin: 0; }

@media print {
  *, *::before, *::after {
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }

  html, body { background: #fff !important; }

  .cvd-root {
    --bg: #fff !important;
    --fg: #141a1f !important;
    --fg-muted: #424d57 !important;
    --fg-sub: #5f6b75 !important;
    --border: #e3e8eb !important;
    --b50:  #eef2ff !important;
    --b100: #e0e7ff !important;
    --b200: #c7d2fe !important;
    --b300: #a5b4fc !important;
    --b500: #4f46e5 !important;
    --b600: #4338ca !important;
    --b700: #3730a3 !important;
    background: #fff !important;
    padding: 0 !important;
    min-height: 0;
  }

  header[data-menu-id], footer, .cvd-toolbar { display: none !important; }

  .cvd-paper {
    max-width: none; width: 100%; margin: 0;
    border: none !important; border-radius: 0 !important; box-shadow: none !important;
    /* overflow:hidden empêchait la coupure et isolait le hero en page 1 */
    overflow: visible !important;
  }

  /* Hero en encadré (identique à l'écran) : fond très clair + bordure indigo,
     texte indigo/foncé. Plus d'aplat de couleur = moins d'encre, impression
     fiable. (Les couleurs de texte/bordure viennent des styles de base.) */
  .cvd-hero {
    background: var(--b50) !important;
    margin: 5mm 7mm 2mm !important;
    padding: 3.5mm 6mm !important;
  }

  .cvd-body { padding: 4mm 11mm 5mm !important; }

  /* Compression print pour tenir sur 1 page */
  .cvd-section { margin-bottom: 6px !important; }
  .cvd-h2 { margin-bottom: 4px !important; }
  .cvd-project { margin-bottom: 5px !important; }
  .cvd-tl-item { margin-bottom: 6px !important; }
  .cvd-skill-row { padding: 1.5px 0 !important; }

  /* On évite seulement les coupures DANS les petits blocs, jamais sur une
     section entière (sinon une section trop grande saute en bloc en page 2
     et laisse le hero seul). */
  .cvd-project, .cvd-tl-item, .cvd-entry, .cvd-mini { page-break-inside: avoid; }
}
</style>
