---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import EmailLink from '@/components/patterns/EmailLink.astro';
import { cv } from '@/data/cv';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

function asEmailParts(v: string) {
  const m = v.match(/^([^@\s]+)@([^@\s]+)$/);
  return m ? { user: m[1], domain: m[2] } : null;
}

const photoExists = existsSync(join(process.cwd(), 'public', 'photo.jpg'));
---

<BaseLayout
  title="CV — Dev IA"
  description={`Curriculum vitae de ${cv.header.name} — ${cv.header.role}. Téléchargeable en PDF.`}
>
  <Header slot="header" position="fixed" shape="bar" variant="solid" size="lg" showCta={false} />

  <div class="cvd-root">

    <!-- Toolbar -->
    <div class="cvd-toolbar no-print">
      <button class="cvd-btn" onclick="window.print()">↓ Télécharger en PDF</button>
    </div>

    <!-- Wrapper papier -->
    <main class="cvd-paper" role="main">

      <!-- Radial glow brand -->
      <div class="cvd-glow" aria-hidden="true"></div>

      <!-- ── HERO / HEADER ──────────────────────────────────── -->
      <header class="cvd-hero" data-reveal>
        <div class="cvd-hero-text">
          <h1 class="cvd-name">{cv.header.name}</h1>
          <p class="cvd-role">{cv.header.role}</p>
          <p class="cvd-summary">{cv.header.summary}</p>

          <!-- Contact pills -->
          <div class="cvd-pills">
            {cv.contact.map((item) => {
              const ep = asEmailParts(item.value);
              return (
                <span class="cvd-pill">
                  <span class="cvd-pill-label">{item.label}</span>
                  {ep
                    ? <EmailLink user={ep.user} domain={ep.domain} class="cvd-pill-link" />
                    : item.href
                      ? <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer" class="cvd-pill-link">{item.value}</a>
                      : <span class="cvd-pill-val">{item.value}</span>}
                </span>
              );
            })}
          </div>
          <p class="cvd-meta" set:html={cv.meta} />
        </div>

        {photoExists && (
          <div class="cvd-photo-wrap">
            <img class="cvd-photo" src="/photo.jpg" alt={cv.header.name} width="88" height="107" />
          </div>
        )}
      </header>

      <!-- ── BODY : 1 colonne (ATS-compatible) ────────────── -->
      <div class="cvd-body">

        <!-- COMPÉTENCES -->
        <section class="cvd-card" data-reveal>
          <h2 class="cvd-card-title">
            <span class="cvd-title-dot" aria-hidden="true"></span>
            Compétences
          </h2>
          <div class="cvd-skills">
            {cv.skills.map((s) => (
              <div class="cvd-skill-row">
                <span class="cvd-badge-cat">{s.category}</span>
                <span class="cvd-skill-val">{s.value}</span>
              </div>
            ))}
          </div>
        </section>

        <!-- PROJETS -->
        <section class="cvd-card" data-reveal>
          <h2 class="cvd-card-title">
            <span class="cvd-title-dot" aria-hidden="true"></span>
            Projets réalisés
          </h2>
          {cv.projects.map((p) => (
            <div class="cvd-project-item">
              <div class="cvd-proj-top">
                <p class="cvd-proj-name">
                  <a href={p.repo} target="_blank" rel="noopener noreferrer">{p.title}</a>
                </p>
                {p.period && <span class="cvd-proj-period">{p.period}</span>}
              </div>
              <p class="cvd-proj-stack">{p.stack}</p>
              <p class="cvd-proj-desc">{p.description}</p>
            </div>
          ))}
        </section>

        <!-- EXPÉRIENCES -->
        <section class="cvd-card" data-reveal>
          <h2 class="cvd-card-title">
            <span class="cvd-title-dot" aria-hidden="true"></span>
            Expériences professionnelles
          </h2>
          {cv.experiences.map((e) => (
            <div class="cvd-exp-item">
              <div class="cvd-exp-meta">
                <div>
                  <p class="cvd-exp-org">{e.org}</p>
                  <p class="cvd-exp-role">{e.role}</p>
                </div>
                <p class="cvd-exp-date">{e.date}</p>
              </div>
              <ul class="cvd-tasks">
                {e.tasks.map((t) => <li>{t}</li>)}
              </ul>
              <div class="cvd-tags">
                {e.stack.split(' · ').map((tech) => (
                  <span class="cvd-tag">{tech}</span>
                ))}
              </div>
            </div>
          ))}
        </section>

        <!-- FORMATIONS -->
        <section class="cvd-card" data-reveal>
          <h2 class="cvd-card-title">
            <span class="cvd-title-dot" aria-hidden="true"></span>
            Formations
          </h2>
          {cv.education.map((ed) => (
            <div class="cvd-entry">
              <span class="cvd-entry-date">{ed.date}</span>
              <div>
                <p class="cvd-entry-title">{ed.title}</p>
                <p class="cvd-entry-sub">{ed.school}</p>
              </div>
            </div>
          ))}
        </section>

        <!-- CERTIFICATIONS -->
        <section class="cvd-card" data-reveal>
          <h2 class="cvd-card-title">
            <span class="cvd-title-dot" aria-hidden="true"></span>
            Certifications
          </h2>
          {cv.certifications.map((c) => (
            <div class="cvd-entry">
              <span class="cvd-entry-date">{c.date}</span>
              <p class="cvd-entry-title">{c.title}</p>
            </div>
          ))}
        </section>

        <!-- INTÉRÊTS -->
        <section class="cvd-card" data-reveal>
          <h2 class="cvd-card-title">
            <span class="cvd-title-dot" aria-hidden="true"></span>
            Centres d'intérêt
          </h2>
          {cv.interests.map((i) => (
            <p class="cvd-interest">
              <strong>{i.title}</strong> — {i.description}
            </p>
          ))}
        </section>

      </div>

    </main>
  </div>
</BaseLayout>

<style is:global>

/* ══════════════════════════════════════════════════════════════
   CV DESIGN — Thème Astro teal, light mode fixé, 1 page A4
   Utilise les tokens exacts du design system du portfolio.
══════════════════════════════════════════════════════════════ */

.cvd-root {
  /* Forcer light mode : on réinjecte tous les tokens teal light */
  --background:           oklch(100%   0      0);
  --background-secondary: oklch(97%    0.012  274);
  --background-tertiary:  oklch(93%    0.025  274);
  --foreground:           oklch(19.4%  0      0);
  --foreground-secondary: oklch(32%    0      0);
  --foreground-muted:     oklch(38%    0      0);
  --foreground-subtle:    oklch(52%    0      0);
  --border:               oklch(91.3%  0      0);
  --border-strong:        oklch(85.8%  0      0);
  --card:                 oklch(100%   0      0);
  --card-border:          oklch(91.3%  0      0);
  /* Indigo — même palette que /cv ATS */
  --brand-50:             oklch(97%    0.02   274);
  --brand-100:            oklch(93%    0.045  274);
  --brand-200:            oklch(85%    0.09   274);
  --brand-300:            oklch(75%    0.14   274);
  --brand-400:            oklch(65%    0.19   274);
  --brand-500:            oklch(53%    0.22   274);
  --brand-600:            oklch(46%    0.21   274);
  --brand-700:            oklch(38%    0.17   274);

  /* Shadow indigo-tinted */
  --shadow-sm: 0 1px 2px oklch(20% 0.05 274 / 0.06);
  --shadow-md: 0 4px 8px oklch(20% 0.05 274 / 0.08), 0 0 1px oklch(20% 0.05 274 / 0.04);
  --shadow-lg: 0 8px 16px oklch(20% 0.05 274 / 0.10), 0 0 1px oklch(20% 0.05 274 / 0.04);

  background: var(--background-secondary);
  min-height: 100vh;
  padding: 5rem 1rem 3rem;
  font-family: 'Manrope Variable', Manrope, system-ui, sans-serif;
  color: var(--foreground);
  -webkit-font-smoothing: antialiased;
  color-scheme: light;
}

/* ── Toolbar ── */
.cvd-toolbar {
  max-width: 860px;
  margin: 0 auto 1rem;
  display: flex;
  justify-content: flex-end;
}

.cvd-btn {
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: white;
  background: var(--brand-600);
  border: none;
  padding: 9px 18px;
  border-radius: 8px;           /* --theme-radius-lg */
  cursor: pointer;
  transition: background 200ms, transform 150ms;
  box-shadow: var(--shadow-sm);
}
.cvd-btn:hover  { background: var(--brand-700); }
.cvd-btn:active { transform: translateY(1px) scale(0.98); }

/* ── Papier (feuille blanche avec background grid) ── */
.cvd-paper {
  position: relative;
  max-width: 860px;
  margin: 0 auto;
  background: var(--card);
  border-radius: 12px;           /* --theme-radius-xl */
  border: 1px solid var(--card-border);
  box-shadow: var(--shadow-lg);
  padding: 1.5rem 2.25rem 1.25rem;
  overflow: hidden;
}

/* Radial glow brand */
.cvd-glow {
  position: absolute;
  top: -60px;
  right: -60px;
  width: 420px;
  height: 420px;
  background: radial-gradient(
    ellipse 80% 80% at 70% 20%,
    color-mix(in oklch, var(--brand-500) 8%, transparent) 0%,
    transparent 70%
  );
  pointer-events: none;
  z-index: 0;
}

/* ── Hero header ── */
.cvd-hero {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 1.25rem;
  padding-bottom: 0.8rem;
  border-bottom: 1px solid var(--border);
  margin-bottom: 0.5rem;
}

.cvd-hero-text { flex: 1; }

.cvd-name {
  font-family: 'Outfit Variable', Outfit, system-ui, sans-serif;
  font-size: 2rem;
  font-weight: 800;
  letter-spacing: -0.03em;          /* --tracking-tighter */
  line-height: 1.1;
  color: var(--foreground);
  margin: 0 0 3px;
}

.cvd-role {
  font-size: 13px;
  font-weight: 700;
  color: var(--brand-600);
  letter-spacing: 0.01em;
  margin: 0 0 5px;
}

.cvd-summary {
  font-size: 11px;
  color: var(--foreground-muted);
  max-width: 54ch;
  line-height: 1.55;
  margin: 0 0 10px;
}

/* Contact : badges pills (comme le composant Badge pill=true du site) */
.cvd-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 4px 8px;
  margin-bottom: 5px;
}

.cvd-pill {
  display: inline-flex;
  align-items: baseline;
  gap: 3px;
  background: var(--background-secondary);
  border: 1px solid var(--border);
  border-radius: 9999px;            /* rounded-full — pill */
  padding: 2px 8px;
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 9.5px;
  transition: border-color 150ms;
}
.cvd-pill:hover { border-color: var(--brand-300); }

.cvd-pill-label { color: var(--foreground-subtle); }
.cvd-pill-val   { color: var(--foreground); }
.cvd-pill-link  { color: var(--foreground); text-decoration: none; border-bottom: 1px solid var(--brand-200); transition: color 150ms, border-color 150ms; }
.cvd-pill-link:hover { color: var(--brand-600); border-color: var(--brand-500); }

.cvd-meta { font-size: 9.5px; color: var(--foreground-muted); margin: 0; }
.cvd-meta strong { color: var(--foreground); font-weight: 600; }

/* Photo — cadre avec ring brand (comme Avatar du site) */
.cvd-photo-wrap {
  position: relative;
  flex-shrink: 0;
}

.cvd-photo-wrap::before {
  content: '';
  position: absolute;
  inset: -2px;
  border-radius: 9px;
  background: linear-gradient(135deg, var(--brand-300), var(--brand-500));
  z-index: 0;
}

.cvd-photo {
  position: relative;
  z-index: 1;
  width: 88px;
  height: 107px;
  object-fit: cover;
  border-radius: 7px;
  display: block;
}

/* ── Layout 1 colonne (ATS-compatible) ── */
.cvd-body {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

/* ── Cards (même pattern que les Card du site) ── */
/* border: 1px solid brand-500/30  hover:border-brand-500/70  rounded-xl */
.cvd-card {
  background: var(--background-secondary);
  border: 1px solid oklch(53% 0.22 274 / 0.20);
  border-radius: 10px;            /* --theme-radius-xl */
  padding: 7px 12px;
  transition: border-color 200ms ease-out;
  box-shadow: var(--shadow-sm);
}
.cvd-card:hover {
  border-color: oklch(53% 0.22 274 / 0.55);
}

/* Card titles — même pattern que les h2 de section du site */
.cvd-card-title {
  display: flex;
  align-items: center;
  gap: 6px;
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 9.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.13em;
  color: var(--foreground);
  margin: 0 0 5px;
}

/* Point décoratif teal devant chaque titre (comme le ■ du CV ATS mais rond) */
.cvd-title-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--brand-500);
  flex-shrink: 0;
}

/* Ligne séparatrice après chaque titre */
.cvd-card-title::after {
  content: '';
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, var(--brand-200), var(--border));
}

/* ── Skills ── */
.cvd-skills {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 2rem;
}

.cvd-skill-row {
  display: grid;
  grid-template-columns: 110px 1fr;
  gap: 4px 8px;
  font-size: 10px;
  padding: 3px 0;
  border-bottom: 1px solid var(--brand-50);
  align-items: start;
}
.cvd-skill-row:last-child { border-bottom: none; }

/* Badge category — comme Badge variant="brand" du site */
.cvd-badge-cat {
  display: inline-flex;
  align-items: center;
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 8.5px;
  font-weight: 700;
  color: var(--brand-600);
  background: oklch(53% 0.22 274 / 0.08);
  border: 1px solid oklch(53% 0.22 274 / 0.18);
  border-radius: 4px;
  padding: 1px 5px;
  white-space: nowrap;
  align-self: start;
}

.cvd-skill-val {
  font-size: 10px;
  color: var(--foreground-secondary);
  line-height: 1.4;
}

/* ── Projets ── */
.cvd-project-item {
  padding: 6px 0;
  border-bottom: 1px solid var(--border);
}
.cvd-project-item:last-child { border-bottom: none; padding-bottom: 0; }

.cvd-proj-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 6px;
  flex-wrap: wrap;
}

.cvd-proj-name {
  font-size: 11px;
  font-weight: 700;
  color: var(--foreground);
  margin: 0;
}
.cvd-proj-name a {
  color: var(--brand-600);
  text-decoration: none;
  border-bottom: 1.5px solid var(--brand-300);
  transition: color 150ms, border-color 150ms;
}
.cvd-proj-name a:hover { color: var(--brand-700); border-color: var(--brand-500); }

.cvd-proj-period {
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 8.5px;
  font-weight: 700;
  color: var(--brand-600);
  background: oklch(53% 0.22 274 / 0.08);
  border: 1px solid oklch(53% 0.22 274 / 0.18);
  border-radius: 4px;
  padding: 1px 5px;
  white-space: nowrap;
}

.cvd-proj-stack {
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 8.5px;
  color: var(--foreground-subtle);
  margin: 1px 0 2px;
}

.cvd-proj-desc {
  font-size: 9.5px;
  color: var(--foreground-muted);
  line-height: 1.4;
  margin: 0;
}

/* ── Expériences ── */
.cvd-exp-item {
  padding: 6px 0;
  border-bottom: 1px solid var(--border);
}
.cvd-exp-item:last-child { border-bottom: none; padding-bottom: 0; }

.cvd-exp-meta {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 8px;
  margin-bottom: 4px;
}

.cvd-exp-org  { font-size: 11px; font-weight: 700; color: var(--foreground); margin: 0; }
.cvd-exp-role { font-size: 10px; font-weight: 600; color: var(--brand-600); margin: 0; }
.cvd-exp-date {
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 8.5px;
  color: var(--foreground-subtle);
  white-space: nowrap;
  padding-top: 2px;
}

.cvd-tasks {
  list-style: none;
  padding: 0;
  margin: 0 0 4px;
}

.cvd-tasks li {
  position: relative;
  padding-left: 11px;
  font-size: 9.5px;
  color: var(--foreground-muted);
  line-height: 1.35;
  margin-bottom: 1px;
}
.cvd-tasks li::before {
  content: "▸";
  position: absolute;
  left: 0;
  color: var(--brand-500);
  font-size: 8px;
  top: 0.15em;
}

/* Tags technos — comme Badge variant="default" du site */
.cvd-tags { display: flex; flex-wrap: wrap; gap: 3px; }

.cvd-tag {
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 8px;
  font-weight: 600;
  color: var(--brand-700);
  background: oklch(53% 0.22 274 / 0.07);
  border: 1px solid oklch(53% 0.22 274 / 0.20);
  padding: 1px 5px;
  border-radius: 4px;
  transition: background 150ms, border-color 150ms;
}
.cvd-tag:hover {
  background: oklch(53% 0.22 274 / 0.14);
  border-color: oklch(53% 0.22 274 / 0.40);
}

/* ── Entrées formations / certifications ── */
.cvd-entry {
  display: grid;
  grid-template-columns: 52px 1fr;
  gap: 6px;
  padding: 3px 0;
  border-bottom: 1px solid var(--border);
  font-size: 10.5px;
}
.cvd-entry:last-child { border-bottom: none; padding-bottom: 0; }

.cvd-entry-date {
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 8.5px;
  font-weight: 700;
  color: var(--brand-600);
  padding-top: 1px;
}

.cvd-entry-title { font-weight: 600; color: var(--foreground); font-size: 10px; margin: 0; }
.cvd-entry-sub   { font-size: 9.5px; color: var(--foreground-muted); margin: 0; }

/* ── Intérêts ── */
.cvd-interest {
  font-size: 10px;
  color: var(--foreground-muted);
  margin: 0 0 2px;
  line-height: 1.4;
}
.cvd-interest:last-child { margin-bottom: 0; }
.cvd-interest strong {
  font-weight: 600;
  color: var(--foreground);
  font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 9px;
}

/* ── Animations écran (scroll reveal du site) ── */
[data-reveal] {
  opacity: 0;
  transform: translateY(24px) scale(0.97);
  transition:
    opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
    transform 0.9s cubic-bezier(0.22, 1.6, 0.36, 1);
}
[data-reveal].is-visible {
  opacity: 1;
  transform: none;
}

/* ════════════════════════════════════════════════════════════
   PRINT — 1 page A4
════════════════════════════════════════════════════════════ */
@page { size: A4; margin: 0; }

@media print {
  *, *::before, *::after {
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }

  html, body { background: white !important; }

  .no-print,
  header[data-menu-id],
  footer { display: none !important; }

  /* Hex fallback indigo en print (identiques à /cv ATS) */
  .cvd-root {
    --background-secondary: #eef2ff !important;
    --brand-50:  #eef2ff !important;
    --brand-100: #e0e7ff !important;
    --brand-200: #c7d2fe !important;
    --brand-300: #a5b4fc !important;
    --brand-500: #4f46e5 !important;
    --brand-600: #4338ca !important;
    --brand-700: #3730a3 !important;
    --foreground: #1a2228 !important;
    --foreground-secondary: #374151 !important;
    --foreground-muted: #5a6670 !important;
    --foreground-subtle: #9ca3af !important;
    --border: #e3e8eb !important;
    --card: #fff !important;
    background: #eef2ff !important;
    padding: 0 !important;
  }

  .cvd-paper {
    max-width: 100%;
    margin: 0;
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    padding: 7mm 10mm 6mm !important;
  }

  .cvd-glow { display: none !important; }

  .cvd-card {
    box-shadow: none !important;
    border-color: #e5e7eb !important;
    background: #f8fcfd !important;
    break-inside: avoid;
    page-break-inside: avoid;
  }

  .cvd-project-item,
  .cvd-exp-item,
  .cvd-entry,
  .cvd-tasks li { page-break-inside: avoid; }

  /* Désactiver animations en print */
  [data-reveal] {
    opacity: 1 !important;
    transform: none !important;
  }
}
</style>

<script>
/* Scroll reveal — même IntersectionObserver que le site */
const observer = new IntersectionObserver(
  (entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add('is-visible');
        observer.unobserve(e.target);
      }
    });
  },
  { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
);

document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
</script>
