---
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import CTA from '@/components/ui/marketing/CTA/CTA.astro';
import { cv } from '@/data/cv';
---

<PageLayout
  title="CV Design — Benjamin Santrisse"
  description="Curriculum vitae visuel — Développeur Backend Python (API, IA appliquée)"
>
  <main class="min-h-screen">
    <!-- HERO SECTION — Vercel minimal style -->
    <section class="relative py-32 px-6 border-b border-border">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-3 gap-12 items-start" data-reveal>
          <!-- Left: Text content -->
          <div class="md:col-span-2 space-y-8">
            <div>
              <h1 class="font-display text-6xl md:text-7xl font-bold text-foreground leading-tight mb-4">
                Benjamin
                <br />
                <span class="text-brand-600">Santrisse</span>
              </h1>
            </div>

            <div class="space-y-4">
              <h2 class="text-2xl font-semibold text-brand-600">
                Développeur Backend Python
              </h2>
              <p class="text-lg text-foreground-secondary max-w-xl leading-relaxed">
                Spécialisé en IA appliquée, pipelines ML et APIs haute performance. Passionné par la création de solutions techniques sophistiquées et scalables.
              </p>
            </div>

            <!-- Stats grid -->
            <div class="grid grid-cols-3 gap-8 pt-8 border-t border-border">
              <div class="space-y-2">
                <div class="text-4xl font-bold text-brand-600">10+</div>
                <div class="text-sm text-foreground-muted">Projets</div>
              </div>
              <div class="space-y-2">
                <div class="text-4xl font-bold text-brand-600">7y</div>
                <div class="text-sm text-foreground-muted">Expérience</div>
              </div>
              <div class="space-y-2">
                <div class="text-4xl font-bold text-brand-600">3y</div>
                <div class="text-sm text-foreground-muted">IA Focus</div>
              </div>
            </div>

            <!-- CTA Buttons -->
            <div class="flex gap-3 pt-4">
              <a
                href="#contact"
                class="px-6 py-2 rounded-lg bg-brand-600 text-white font-semibold hover:bg-brand-700 transition-colors"
              >
                Me contacter
              </a>
              <a
                href="/cv"
                class="px-6 py-2 rounded-lg border border-border bg-background-secondary text-foreground font-semibold hover:border-brand-400 transition-colors"
              >
                CV classique
              </a>
            </div>
          </div>

          <!-- Right: Photo -->
          <div class="hidden md:block" data-reveal>
            <div class="relative aspect-square rounded-xl overflow-hidden border border-border bg-background-secondary shadow-sm hover:shadow-md transition-shadow">
              <img
                src="/photo.jpg"
                alt="Benjamin Santrisse"
                class="w-full h-full object-cover"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- COMPÉTENCES SECTION -->
    <section class="py-20 px-6 border-b border-border">
      <div class="max-w-5xl mx-auto">
        <div class="mb-12" data-reveal>
          <h2 class="font-display text-4xl font-bold text-foreground mb-2">Compétences</h2>
          <p class="text-foreground-secondary">Expertises techniques et domaines de spécialisation</p>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          {cv.skills.map((skill, idx) => (
            <div
              key={idx}
              class="group p-6 rounded-lg border border-border bg-background-secondary hover:border-brand-400 hover:bg-card transition-all duration-200 data-reveal"
              style={{ transitionDelay: `${idx * 30}ms` }}
            >
              <div class="flex items-start gap-3 mb-3">
                <div class="w-1 h-6 bg-brand-600 rounded-full mt-1 group-hover:h-8 transition-all" />
                <h3 class="text-lg font-semibold text-foreground group-hover:text-brand-600 transition-colors">
                  {skill.category}
                </h3>
              </div>
              <p class="text-foreground-secondary text-sm leading-relaxed ml-4">
                {skill.value}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PROJETS SECTION -->
    <section class="py-20 px-6 border-b border-border">
      <div class="max-w-5xl mx-auto">
        <div class="mb-12" data-reveal>
          <h2 class="font-display text-4xl font-bold text-foreground mb-2">Projets</h2>
          <p class="text-foreground-secondary">Réalisations techniques et collaborations</p>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          {cv.projects.map((project, idx) => (
            <div
              key={idx}
              class="group flex flex-col p-6 rounded-lg border border-border bg-background-secondary hover:border-brand-400 hover:shadow-sm transition-all duration-200 data-reveal"
              style={{ transitionDelay: `${idx * 30}ms` }}
            >
              <div class="flex items-start justify-between mb-3">
                <h3 class="text-xl font-semibold text-foreground group-hover:text-brand-600 transition-colors flex-1">
                  {project.title}
                </h3>
                <Icon
                  name="external-link"
                  size="sm"
                  class="text-foreground-muted group-hover:text-brand-600 transition-colors opacity-0 group-hover:opacity-100 flex-shrink-0"
                />
              </div>

              {project.period && (
                <p class="text-xs text-foreground-muted mb-3">{project.period}</p>
              )}

              <p class="text-foreground-secondary text-sm mb-4 flex-grow leading-relaxed">
                {project.description}
              </p>

              <!-- Tech stack -->
              <div class="flex flex-wrap gap-2 mb-4 pt-4 border-t border-border">
                {project.stack.split(' · ').map((tech, i) => (
                  <span
                    key={i}
                    class="px-2 py-1 rounded text-xs font-medium bg-card text-foreground-secondary border border-border/50"
                  >
                    {tech}
                  </span>
                ))}
              </div>

              <!-- Link -->
              {project.repo && (
                <a
                  href={project.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-brand-600 hover:text-brand-700 text-sm font-semibold transition-colors"
                >
                  Voir sur GitHub
                  <Icon name="arrow-right" size="sm" />
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- EXPÉRIENCE SECTION -->
    <section class="py-20 px-6 border-b border-border">
      <div class="max-w-4xl mx-auto">
        <div class="mb-12" data-reveal>
          <h2 class="font-display text-4xl font-bold text-foreground mb-2">Expérience</h2>
          <p class="text-foreground-secondary">Parcours professionnel</p>
        </div>

        <div class="space-y-8">
          {cv.experiences.map((exp, idx) => (
            <div
              key={idx}
              class="group data-reveal"
              style={{ transitionDelay: `${idx * 30}ms` }}
            >
              <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-2 mb-3">
                <div>
                  <h3 class="text-xl font-semibold text-foreground group-hover:text-brand-600 transition-colors">
                    {exp.role}
                  </h3>
                  <p class="text-brand-600 font-medium">{exp.org}</p>
                </div>
                <p class="text-sm text-foreground-muted whitespace-nowrap">{exp.date}</p>
              </div>

              {exp.tasks && (
                <ul class="space-y-2 mb-4 ml-0">
                  {exp.tasks.map((task, i) => (
                    <li key={i} class="text-foreground-secondary text-sm flex gap-3">
                      <span class="text-brand-600 flex-shrink-0 mt-1">▸</span>
                      <span>{task}</span>
                    </li>
                  ))}
                </ul>
              )}

              {exp.stack && (
                <div class="flex flex-wrap gap-2 pt-3 border-t border-border">
                  {exp.stack.split(' · ').map((tech, i) => (
                    <span key={i} class="text-xs px-2 py-1 rounded bg-card text-foreground-secondary border border-border/50">
                      {tech}
                    </span>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FORMATIONS SECTION -->
    <section class="py-20 px-6 border-b border-border">
      <div class="max-w-4xl mx-auto">
        <div class="mb-12" data-reveal>
          <h2 class="font-display text-4xl font-bold text-foreground mb-2">Formations</h2>
          <p class="text-foreground-secondary">Parcours académique et certifications</p>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {cv.education.map((edu, idx) => (
            <div
              key={idx}
              class="p-6 rounded-lg border border-border bg-background-secondary hover:border-brand-400 transition-colors data-reveal"
              style={{ transitionDelay: `${idx * 30}ms` }}
            >
              <div class="text-3xl font-bold text-brand-600 mb-3">{edu.date}</div>
              <h3 class="text-lg font-semibold text-foreground mb-1">{edu.title}</h3>
              <p class="text-sm text-foreground-secondary">{edu.school}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CONTACT SECTION -->
    <section id="contact" class="py-20 px-6">
      <CTA variant="default" size="md" maxWidth="lg" glow={false} data-reveal>
        <h2 slot="heading" class="!text-4xl">Discutons ensemble</h2>
        <p slot="description" class="!text-base">
          Intéressé par une collaboration ou une opportunité ? Contactez-moi pour en discuter.
        </p>

        <div class="flex flex-wrap gap-3 justify-center">
          {cv.contact.map((item) => (
            item.href && (
              <a
                key={item.label}
                href={item.href}
                target={item.href.startsWith('http') ? '_blank' : undefined}
                rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-border bg-background-secondary text-foreground font-medium hover:border-brand-400 hover:text-brand-600 transition-colors text-sm"
              >
                <Icon name="mail" size="sm" />
                {item.label}
              </a>
            )
          ))}
        </div>
      </CTA>
    </section>
  </main>
</PageLayout>

<style>
  [data-reveal] {
    animation: revealUp 0.6s ease-out forwards;
    opacity: 0;
  }

  @keyframes revealUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
