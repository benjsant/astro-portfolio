---
import PageLayout from '@/layouts/PageLayout.astro';
import EmailLink from '@/components/patterns/EmailLink.astro';
import { cv } from '@/data/cv';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

function asEmailParts(value: string): { user: string; domain: string } | null {
  const m = value.match(/^([^@\s]+)@([^@\s]+)$/);
  return m ? { user: m[1], domain: m[2] } : null;
}

const photoExists = existsSync(join(process.cwd(), 'public', 'photo.jpg'));
---

<PageLayout
  title="CV Design"
  description={`Curriculum vitae de ${cv.header.name} — ${cv.header.role}. Téléchargeable en PDF.`}
>
  <main class="!bg-white !text-black min-h-screen pt-20 pb-12 px-6">
    <div class="max-w-4xl mx-auto pb-4 flex justify-end no-print">
      <button type="button" class="px-3 py-1 text-xs rounded bg-blue-600 text-white font-semibold" onclick="window.print()">
        ↓ PDF
      </button>
    </div>

    <article class="bg-white rounded-lg border border-gray-200 p-8 md:p-10 shadow-sm">
      <!-- HEADER avec photo petite en haut à droite -->
      <header class="flex justify-between items-start pb-8 border-b border-gray-200 mb-8">
        <div class="flex-1">
          <h1 class="text-5xl font-bold text-black mb-3">{cv.header.name}</h1>
          <p class="text-lg font-semibold text-blue-600 mb-3">{cv.header.role}</p>
          <p class="text-sm text-gray-700 leading-relaxed max-w-2xl">{cv.header.summary}</p>
        </div>
        {photoExists && (
          <img
            src="/photo.jpg"
            alt={cv.header.name}
            class="w-20 h-24 rounded border border-gray-200 object-cover flex-shrink-0 ml-4"
          />
        )}
      </header>

      <!-- CONTACT -->
      <div class="flex flex-wrap gap-4 text-sm mb-6 pb-6 border-b border-gray-200">
        {cv.contact.map((item) => {
          const emailParts = asEmailParts(item.value);
          return (
            <div class="flex items-center gap-2">
              <span class="text-gray-600 font-medium">{item.label}:</span>
              {emailParts ? (
                <EmailLink user={emailParts.user} domain={emailParts.domain} class="text-blue-600" />
              ) : item.href ? (
                <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined} class="text-blue-600">
                  {item.value}
                </a>
              ) : (
                <span>{item.value}</span>
              )}
            </div>
          );
        })}
      </div>
      <p class="text-xs text-gray-600 mb-6 pb-6 border-b border-gray-200" set:html={cv.meta} />

      <!-- COMPÉTENCES -->
      <section class="mb-6 pb-6 border-b border-gray-200">
        <h2 class="text-sm font-bold text-black mb-4 uppercase tracking-wide">Compétences</h2>
        <div class="grid grid-cols-2 gap-4">
          {cv.skills.map((skill) => (
            <div>
              <h3 class="text-xs font-semibold text-blue-600 mb-1">{skill.category}</h3>
              <p class="text-xs text-gray-700">{skill.value}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- PROJETS -->
      <section class="mb-6 pb-6 border-b border-gray-200">
        <h2 class="text-sm font-bold text-black mb-4 uppercase tracking-wide">Projets réalisés</h2>
        <div class="space-y-3">
          {cv.projects.map((project) => (
            <div>
              <div class="flex justify-between items-baseline gap-2">
                <h3 class="font-semibold text-sm">
                  <a href={project.repo} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">
                    {project.title}
                  </a>
                </h3>
                <span class="text-xs text-gray-500 whitespace-nowrap">{project.stack}</span>
              </div>
              {project.period && <p class="text-xs text-blue-600 font-mono">{project.period}</p>}
              <p class="text-xs text-gray-700 leading-relaxed">{project.description}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- EXPÉRIENCES -->
      <section class="mb-6 pb-6 border-b border-gray-200">
        <h2 class="text-sm font-bold text-black mb-4 uppercase tracking-wide">Expériences professionnelles</h2>
        <div class="space-y-3">
          {cv.experiences.map((exp) => (
            <div>
              <div class="flex justify-between items-baseline gap-2 mb-2">
                <div>
                  <h3 class="font-semibold text-sm text-black">{exp.org}</h3>
                  <p class="text-xs font-semibold text-blue-600">{exp.role}</p>
                </div>
                <span class="text-xs text-gray-500 text-right whitespace-nowrap">{exp.date}</span>
              </div>
              <ul class="space-y-1 mb-2 ml-2">
                {exp.tasks.map((task) => (
                  <li class="text-xs text-gray-700 flex gap-2">
                    <span class="text-blue-600 flex-shrink-0">▸</span>
                    <span>{task}</span>
                  </li>
                ))}
              </ul>
              <div class="flex flex-wrap gap-1">
                {exp.stack.split(' · ').map((tech) => (
                  <span class="text-xs px-2 py-1 rounded bg-blue-100 text-blue-700">{tech}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- FORMATIONS -->
      <section class="mb-6 pb-6 border-b border-gray-200">
        <h2 class="text-sm font-bold text-black mb-4 uppercase tracking-wide">Formations</h2>
        <div class="space-y-2">
          {cv.education.map((entry) => (
            <div class="flex gap-4 text-xs">
              <span class="font-mono font-semibold text-blue-600 flex-shrink-0">{entry.date}</span>
              <div>
                <p class="font-semibold text-black">{entry.title}</p>
                <p class="text-gray-700">{entry.school}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- CERTIFICATIONS -->
      <section class="mb-6 pb-6 border-b border-gray-200">
        <h2 class="text-sm font-bold text-black mb-4 uppercase tracking-wide">Certifications</h2>
        <div class="space-y-2">
          {cv.certifications.map((c) => (
            <div class="flex gap-4 text-xs">
              <span class="font-mono font-semibold text-blue-600 flex-shrink-0">{c.date}</span>
              <p class="font-semibold text-black">{c.title}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- CENTRES D'INTÉRÊT -->
      <section>
        <h2 class="text-sm font-bold text-black mb-4 uppercase tracking-wide">Centres d'intérêt</h2>
        <div class="space-y-1 text-xs text-gray-700">
          {cv.interests.map((i) => (
            <p>
              <strong class="text-black">{i.title}</strong> — {i.description}
            </p>
          ))}
        </div>
      </section>
    </article>
  </main>
</PageLayout>

<style is:global>
  main {
    background-color: white !important;
    color: black !important;
  }

  .no-print {
    print-color-adjust: exact !important;
  }

  @page {
    size: A4;
    margin: 10mm;
  }

  @media print {
    * {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    html, body, main {
      background: white !important;
      color: black !important;
    }

    .no-print {
      display: none !important;
    }

    header[data-menu-id],
    footer {
      display: none !important;
    }

    article {
      box-shadow: none !important;
      page-break-inside: avoid;
    }

    section {
      page-break-inside: avoid;
    }
  }
</style>
