        </Card>

        <!-- BTS SIO -->
        <Card variant="elevated" padding="lg" hover data-reveal data-reveal-delay="3">
          <div class="flex flex-col h-full gap-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
                <Icon name="graduation-cap" size="sm" />
              </div>
              <Badge variant="brand" size="sm">2015 - 2017</Badge>
            </div>
            <div>
              <h3 class="text-base font-semibold text-foreground">BTS SIO · option SLAM</h3>
