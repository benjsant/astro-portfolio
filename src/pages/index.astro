---
import LandingLayout from '@/layouts/LandingLayout.astro';
import { Hero } from '@/components/hero';
import Button from '@/components/ui/form/Button/Button.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import EmailLink from '@/components/patterns/EmailLink.astro';
import { getCollection } from 'astro:content';
import siteConfig from '@/config/site.config';

const projectItems = await getCollection('projects');
const featuredProjects = projectItems
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---

<LandingLayout
  title="Développeur Python · IA, Data & Automatisation"
  description="Développeur Python : pipelines de données, APIs FastAPI, orchestration (Airflow, Prefect, n8n), agents LLM et automatisation système. Basé près de Valenciennes, mobile sur la métropole lilloise."
  includePersonSchema={true}
  includeProfessionalServiceSchema={true}
>
  <!-- Hero -->
  <Hero layout="centered" size="xl" class="hero-dark-gradient" showScrollIndicator>
    <Badge slot="badge" variant="brand" pill pulse class="dark:text-brand-200">Disponible · Ouvert aux opportunités</Badge>

    <h1 slot="title">
      <span class="text-brand-600 dark:text-foreground [-webkit-text-fill-color:currentColor]">Développeur Python</span><br />
      <span class="text-brand-600 dark:text-foreground [-webkit-text-fill-color:currentColor]">IA, Data &amp; Automatisation</span>
    </h1>

    <p slot="description">
      Je conçois des systèmes concrets : pipelines de données, APIs, orchestration et agents LLM.
      La chaîne complète m'intéresse : collecte, traitement, modèle, exposition par API.
    </p>

    <Fragment slot="actions">
      <Button size="lg" href="/cv">
        <Icon name="file-text" size="sm" />
        Voir mon CV
      </Button>
      <Button size="lg" variant="outline" href="#work">
        Voir mes projets
        <Icon name="arrow-right" size="sm" />
      </Button>
    </Fragment>
  </Hero>

  <!-- Services Section -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>Expertises</Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            Ce que je fais
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto">
          Du traitement de la donnée à l'exploitation en production chez le client.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-2">
        <!-- IA & LLMs -->
        <Card hover data-reveal>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="bot" size="sm" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">IA & LLMs</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Intégration de LLMs (DeepSeek, Claude), systèmes RAG, agents IA et automatisation intelligente de workflows métier.
              </p>
            </div>
          </div>
        </Card>

        <!-- Data Engineering -->
        <Card hover data-reveal data-reveal-delay="1">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="database" size="sm" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Data Engineering</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Pipelines ETL robustes, APIs FastAPI, bases PostgreSQL et orchestration Prefect pour des flux de données fiables et reproductibles.
              </p>
            </div>
          </div>
        </Card>

        <!-- MLOps -->
        <Card hover data-reveal data-reveal-delay="2">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="flask-conical" size="sm" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">MLOps & Déploiement</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Entraînement et suivi de modèles avec MLflow, conteneurisation Docker et pipelines CI/CD pour packager et exécuter les modèles de façon reproductible.
              </p>
            </div>
          </div>
        </Card>

        <!-- Automatisation & Intégration -->
        <Card hover data-reveal data-reveal-delay="3">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="workflow" size="sm" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Automatisation & Intégration</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Orchestration de traitements avec Airflow, Prefect et n8n. Connecteurs API, synchronisation entre systèmes, reprise et déduplication de données, automatisation d'environnements Linux.
              </p>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- Portfolio -->
  <section id="work" class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>Projets réalisés</Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            Ce que j'ai construit
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto">
          Une sélection de projets récents. Code source public, tests et documentation.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {featuredProjects.map((project) => (
          <Card variant="elevated" hover padding="lg" href={`/projects/${project.id.replace(/\.mdx?$/, '')}`} class="group flex flex-col" data-reveal>
            <div class="flex flex-1 flex-col">
