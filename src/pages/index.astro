---
import LandingLayout from '@/layouts/LandingLayout.astro';
import { Hero } from '@/components/hero';
import Button from '@/components/ui/form/Button/Button.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import LighthouseScores from '@/components/landing/LighthouseScores.astro';
import LetterGlitchBand from '@/components/patterns/LetterGlitchBand.astro';
import { getCollection } from 'astro:content';
import siteConfig from '@/config/site.config';

const projectItems = await getCollection('projects');
const featuredProjects = projectItems
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---

<LandingLayout
  title="Benjamin Santrisse — Développeur IA & Data"
  description="Développeur spécialisé en Intelligence Artificielle et Data Engineering. Pipelines ML, APIs FastAPI, orchestration Airflow, LLMs. Disponible pour de nouvelles opportunités."
  image="/og-default.svg"
  includePersonSchema={true}
  includeProfessionalServiceSchema={true}
>
  <!-- Hero -->
  <Hero layout="centered" size="xl" class="hero-dark-gradient" showScrollIndicator>
    <Badge slot="badge" variant="brand" pill pulse class="dark:text-brand-200">Disponible · Open to work</Badge>

    <h1 slot="title">
      <span class="text-brand-600 dark:text-foreground [-webkit-text-fill-color:currentColor]">Développeur</span><br />
      <span class="text-brand-600 dark:text-foreground [-webkit-text-fill-color:currentColor]">IA &amp; Data</span>
    </h1>

    <p slot="description">
      Je conçois et déploie des systèmes IA concrets — pipelines ML, APIs, orchestration et LLMs.
      Passionné par la chaîne complète : de la donnée brute au modèle en production.
    </p>

    <Fragment slot="actions">
      <Button size="lg" href="/cv.pdf" target="_blank" rel="noopener noreferrer">
        <Icon name="download" size="sm" />
        Télécharger mon CV
      </Button>
      <Button size="lg" variant="outline" href="#work">
        Voir mes projets
        <Icon name="arrow-right" size="sm" />
      </Button>
    </Fragment>
  </Hero>

  <!-- Services Section -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>Expertises</Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            Ce que je fais
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto">
          De la donnée brute au modèle en production.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <!-- IA & LLMs -->
        <Card hover data-reveal>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="bot" size="sm" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">IA & LLMs</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Intégration de LLMs (DeepSeek, Claude), systèmes RAG, agents IA et automatisation intelligente de workflows métier.
              </p>
            </div>
          </div>
        </Card>

        <!-- Data Engineering -->
        <Card hover data-reveal data-reveal-delay="1">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="database" size="sm" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Data Engineering</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Pipelines ETL robustes, APIs FastAPI, bases PostgreSQL et orchestration Airflow pour des flux de données fiables en production.
              </p>
            </div>
          </div>
        </Card>

        <!-- MLOps -->
        <Card hover data-reveal data-reveal-delay="2">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="flask-conical" size="sm" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">MLOps & Déploiement</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Entraînement et suivi de modèles avec MLflow, conteneurisation Docker et pipelines CI/CD pour mettre les modèles en production.
              </p>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- Portfolio -->
  <section id="work" class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>Projets réalisés</Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            Ce que j'ai construit
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto">
          Une sélection de projets récents — de la donnée brute au modèle déployé.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {featuredProjects.map((project) => (
          <Card variant="elevated" hover padding="lg" href={`/projects/${project.id.replace(/\.mdx?$/, '')}`} class="group flex flex-col" data-reveal>
            <div class="flex flex-1 flex-col">
              <div class="mb-3 flex items-start justify-between gap-4">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
                  <Icon name="layers" size="sm" />
                </div>
                <Icon name="arrow-up-right" size="sm" class="text-foreground-muted group-hover:text-brand-500 transition-colors shrink-0" />
              </div>
              <div class="mb-2 flex items-baseline gap-2">
                <h3 class="font-display text-lg font-bold text-foreground">{project.data.title}</h3>
                {project.data.year && (
                  <span class="text-xs text-foreground-muted">{project.data.year}</span>
                )}
              </div>
              <p class="text-sm text-foreground-muted leading-relaxed mb-4 flex-1">{project.data.description}</p>
              <div class="flex flex-wrap gap-1.5">
                {project.data.tags.map((tag) => (
                  <Badge variant="brand">{tag}</Badge>
                ))}
              </div>
            </div>
          </Card>
        ))}
      </div>

      <div class="flex justify-center">
        <Button variant="outline" href="/projects">
          Voir tous les projets
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </div>
  </section>

  <!-- Parcours & Formation -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>Parcours</Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            Formation & expérience
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto">
          Un profil ancré dans le terrain — projets concrets, certification récente, disponible immédiatement.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <!-- Formation Simplon -->
        <Card variant="elevated" padding="lg" hover data-reveal>
          <div class="flex flex-col h-full gap-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
                <Icon name="graduation-cap" size="sm" />
              </div>
              <Badge variant="brand" size="sm">2025 – 2026</Badge>
            </div>
            <div>
              <h3 class="text-base font-semibold text-foreground">Développeur IA — RNCP Niv. 6</h3>
              <p class="text-sm text-foreground-muted mt-0.5">Simplon, Lille</p>
            </div>
            <p class="text-sm text-foreground-muted leading-relaxed flex-1">
              Formation intensive axée sur Python, Machine Learning, Deep Learning, MLOps et déploiement de modèles. Certification professionnelle reconnue équivalent Bac+3/4.
            </p>
            <div class="flex flex-wrap gap-1.5 pt-2 border-t border-border">
              <Badge size="sm" variant="brand">Python</Badge>
              <Badge size="sm" variant="brand">ML / DL</Badge>
              <Badge size="sm" variant="brand">MLOps</Badge>
              <Badge size="sm" variant="brand">FastAPI</Badge>
              <Badge size="sm" variant="brand">Docker</Badge>
            </div>
          </div>
        </Card>

        <!-- Expérience + disponibilité -->
        <Card variant="elevated" padding="lg" hover data-reveal data-reveal-delay="1">
          <div class="flex flex-col h-full gap-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
                <Icon name="briefcase" size="sm" />
              </div>
              <Badge variant="brand" size="sm" class="dark:text-brand-200">Disponible · Open to work</Badge>
            </div>
            <div>
              <h3 class="text-base font-semibold text-foreground">Recherche active d'emploi</h3>
              <p class="text-sm text-foreground-muted mt-0.5">Métropole Valenciennoise + Lilloise · Remote</p>
            </div>
            <p class="text-sm text-foreground-muted leading-relaxed flex-1">
              Développeur passionné par la chaîne complète de l'IA — de la collecte de données au modèle en production. À la recherche d'un poste dans lequel mettre mes projets concrets en valeur.
            </p>
            <div class="flex flex-wrap gap-1.5 pt-2 border-t border-border">
              <Badge size="sm" variant="brand">ML Engineer</Badge>
              <Badge size="sm" variant="brand">Data Engineer</Badge>
              <Badge size="sm" variant="brand">Dev IA</Badge>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>


  <!-- About Teaser -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-12 lg:grid-cols-2">
        <div class="flex flex-col justify-center" data-reveal="right">
          <div class="flex flex-col gap-6 mb-6">
            <Badge variant="brand" pill class="self-start">À propos</Badge>
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
              Développeur IA,<br />
              <span class="text-brand-500">passionné de data.</span>
            </h2>
          </div>
          <p class="text-lg text-foreground-muted leading-relaxed mb-4">
            Spécialisé en Intelligence Artificielle et Data Engineering, je construis des systèmes IA concrets et déployables — de la collecte de données jusqu'au modèle en production.
          </p>
          <p class="text-lg text-foreground-muted leading-relaxed mb-8">
            Passionné par les LLMs, le MLOps et l'automatisation intelligente. Toujours en veille sur les dernières avancées de l'écosystème IA.
          </p>
           <Button variant="outline" href="/about" class="self-start">
            En savoir plus
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>
        <Card variant="elevated" padding="lg" class="h-full flex flex-col" data-reveal="left" data-reveal-delay="1">
          <p class="text-sm text-foreground mb-5 text-center">En quelques chiffres.</p>
          <div class="grid grid-cols-2 gap-3 flex-1 auto-rows-fr">
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 cursor-default h-full">
              <Icon name="graduation-cap" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">Certifié<br />Développeur IA</p>
              <p class="text-xs text-foreground-muted">RNCP Niv. 6 — Simplon</p>
            </div>
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 cursor-default h-full">
              <Icon name="layers" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">10+ projets<br />déployés</p>
              <p class="text-xs text-foreground-muted">IA, Data, APIs, CI/CD</p>
            </div>
            <a href={siteConfig.socialLinks[0]} target="_blank" rel="noopener noreferrer" class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 h-full">
              <Icon name="brand-github" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">GitHub</p>
              <p class="text-xs text-foreground-muted">benjsant</p>
            </a>
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 cursor-default h-full">
              <Icon name="map-pin" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">Basé à<br />{siteConfig.address?.city ?? 'France'}</p>
              <p class="text-xs text-foreground-muted">Métropole Valenciennoise</p>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- Blog -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-6 text-center" data-reveal>
        <Badge variant="brand" pill>Blog</Badge>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
          Articles récents
        </h2>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            href={`/blog/${post.id.replace('en/', '')}`}
            publishedAt={post.data.publishedAt}
            tags={post.data.tags}
            author={post.data.author}
            image={post.data.image}
            svgSlug={post.data.svgSlug}
          />
        ))}
      </div>

      <div class="flex justify-center">
        <Button variant="outline" href="/blog">
          Voir tous les articles
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </div>
  </section>

 <!-- CTA -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <!-- Mobile: flat section, no card -->
    <div class="glitch:hidden mx-auto max-w-2xl px-6 text-center" data-reveal>
      <Badge variant="brand" pill class="mb-6">Let's talk</Badge>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        Une opportunité à me proposer ?
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        Disponible pour un poste en IA, ML Engineering ou Data — parlons-en.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" href="/contact" class="cta-btn-brand">
          Me contacter
          <Icon name="arrow-right" size="sm" />
        </Button>
        <Button size="lg" variant="outline" href="/about">
          En savoir plus
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </div>

    <!-- Desktop: contained LetterGlitch band with glass card -->
    <LetterGlitchBand>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        Une opportunité à me proposer ?
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        Disponible pour un poste en IA, ML Engineering ou Data — parlons-en.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" href="/contact" class="hero-btn-brand">
          Me contacter
          <Icon name="arrow-right" size="sm" />
        </Button>
        <Button size="lg" variant="outline" href="/about">
          En savoir plus
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </LetterGlitchBand>
  </section>

<script>
  function initCountup() {
    const counters = document.querySelectorAll<HTMLElement>('[data-countup]:not([data-countup-init])');
    if (counters.length === 0) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        observer.unobserve(entry.target);
        const el = entry.target as HTMLElement;
        const target = parseInt(el.dataset.countup ?? '0', 10);
        const suffix = el.dataset.suffix ?? '';
        const duration = 1200;
        const start = performance.now();
        const tick = (now: number) => {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.round(eased * target) + suffix;
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.4 });
    counters.forEach((el) => {
      el.dataset.countupInit = 'true';
      observer.observe(el);
    });
  }

  initCountup();
</script>

</LandingLayout>
