---
/**
 * CV page
 * URL: /cv
 *
 * Toutes les données viennent de `src/data/cv.ts`. Pour modifier le contenu,
 * édite ce fichier — pas besoin de toucher au HTML/CSS ci-dessous.
 *
 * Photo :
 *   - Pose `public/photo.jpg` (ratio ~3:4, idéal ~432×528 px)
 *   - Détection auto au build
 *
 * Téléchargement PDF :
 *   - Bouton "Télécharger en PDF" → window.print()
 *   - Le rendu print est compact mais reste proche du rendu écran
 *   - `@page margin: 0` supprime les en-têtes du navigateur (URL, "Firefox"…)
 *   - Le chat widget et les overlays sont masqués en print
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import EmailLink from '@/components/patterns/EmailLink.astro';
import { cv } from '@/data/cv';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

// Détecte si une valeur est un email (pour utiliser le composant obfusqué)
function asEmailParts(value: string): { user: string; domain: string } | null {
  const m = value.match(/^([^@\s]+)@([^@\s]+)$/);
  return m ? { user: m[1], domain: m[2] } : null;
}

const photoExists = existsSync(join(process.cwd(), 'public', 'photo.jpg'));
---

<BaseLayout
  title="CV"
  description={`Curriculum vitae de ${cv.header.name} — ${cv.header.role}. Téléchargeable en PDF.`}
>
  <Header
    slot="header"
    position="fixed"
    shape="bar"
    variant="solid"
    size="lg"
    showCta={false}
  />

  <main class="cv-page pt-20 pb-12">
    <div class="cv-toolbar">
      <button type="button" class="cv-print-btn" onclick="window.print()">
        ↓ Télécharger en PDF
      </button>
    </div>

    <article class="cv-sheet">
      <!-- HEADER -->
      <header class="cv-header">
        <div class="cv-identity">
          <h1 class="cv-name">{cv.header.name}</h1>
          <p class="cv-role">{cv.header.role}</p>
          <p class="cv-summary">{cv.header.summary}</p>
        </div>
        {photoExists ? (
          <img class="cv-photo" src="/photo.jpg" alt={cv.header.name} width="108" height="132" />
        ) : (
          <div class="cv-photo cv-photo-placeholder">
            <span>Photo</span>
            <span>108 × 132</span>
            <span class="cv-photo-hint">public/photo.jpg</span>
          </div>
        )}
      </header>

      <!-- CONTACT -->
      <div class="cv-contact">
        {cv.contact.map((item) => {
          const emailParts = asEmailParts(item.value);
          return (
            <span>
              <span class="cv-label">{item.label} :</span>{' '}
              {emailParts ? (
                <EmailLink user={emailParts.user} domain={emailParts.domain} class="cv-email" />
              ) : item.href ? (
                <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
                  {item.value}
                </a>
              ) : (
                item.value
              )}
            </span>
          );
        })}
      </div>
      <p class="cv-meta" set:html={cv.meta} />

      <!-- COMPÉTENCES -->
      <section class="cv-section">
        <h2>Compétences</h2>
        {cv.skills.map((row) => (
          <div class="cv-skill-row">
            <div class="cv-skill-cat">{row.category}</div>
            <div class="cv-skill-val">{row.value}</div>
          </div>
        ))}
      </section>

      <!-- PROJETS -->
      <section class="cv-section">
        <h2>Projets réalisés</h2>
        {cv.projects.map((project) => (
          <div class="cv-project">
            <div class="cv-project-head">
              <div class="cv-project-title">
                <a href={project.repo} target="_blank" rel="noopener noreferrer">{project.title}</a>
              </div>
              <div class="cv-stack">{project.stack}</div>
            </div>
            {project.period && <div class="cv-project-period">{project.period}</div>}
            <p class="cv-project-desc">{project.description}</p>
          </div>
        ))}
      </section>

      <!-- EXPÉRIENCES -->
      <section class="cv-section">
        <h2>Expériences professionnelles</h2>
        {cv.experiences.map((exp) => (
          <div class="cv-experience">
            <div class="cv-job-head">
              <div>
                <div class="cv-job-org">{exp.org}</div>
                <div class="cv-job-role">{exp.role}</div>
              </div>
              <div class="cv-job-date">{exp.date}</div>
            </div>
            <ul class="cv-tasks">
              {exp.tasks.map((t) => <li>{t}</li>)}
            </ul>
            <span class="cv-env">{exp.stack}</span>
          </div>
        ))}
      </section>

      <!-- FORMATIONS -->
      <section class="cv-section">
        <h2>Formations</h2>
        {cv.education.map((entry) => (
          <div class="cv-entry">
            <div class="cv-entry-date">{entry.date}</div>
            <div class="cv-entry-body">
              <strong>{entry.title}</strong>
              <span>{entry.school}</span>
            </div>
          </div>
        ))}
      </section>

      <!-- CERTIFICATIONS -->
      <section class="cv-section">
        <h2>Certifications</h2>
        {cv.certifications.map((c) => (
          <div class="cv-entry">
            <div class="cv-entry-date">{c.date}</div>
            <div class="cv-entry-body"><strong>{c.title}</strong></div>
          </div>
        ))}
      </section>

      <!-- INTÉRÊTS -->
      <section class="cv-section">
        <h2>Centres d'intérêt</h2>
        <div class="cv-interests">
          {cv.interests.map((i) => (
            <p><strong>{i.title}</strong> &nbsp;—&nbsp; {i.description}</p>
          ))}
        </div>
      </section>
    </article>
  </main>
</BaseLayout>

<style is:global>
  /* ──────────────────────────────────────────────────────────────────────────
     CV page — palette portfolio (teal), mode clair fixé.
     L'écran et le PDF utilisent les mêmes proportions : ce que tu vois à
     l'écran = ce que tu auras dans le PDF (à 1 ou 2 px près).
  ────────────────────────────────────────────────────────────────────────── */

  .cv-page {
    /* Vars portfolio en mode clair fixé */
    --background: oklch(100% 0 0);
    --background-secondary: oklch(97.5% 0.010 190);
    --foreground: oklch(20% 0.01 250);
    --foreground-muted: oklch(45% 0.01 250);
    --foreground-subtle: oklch(60% 0.005 250);
    --border: oklch(92% 0.006 220);
    --border-strong: oklch(85% 0.006 220);

    /* Indigo profond — couleur signature du CV (distincte du teal du
       portfolio pour différencier les 2 supports visuellement). */
    --brand-50:  oklch(97% 0.02 274);
    --brand-100: oklch(93% 0.045 274);
    --brand-500: oklch(53% 0.22 274);
    --brand-600: oklch(46% 0.21 274);
    --brand-700: oklch(38% 0.17 274);

    --color-background: var(--background);
    --color-foreground: var(--foreground);
    --color-foreground-muted: var(--foreground-muted);
    --color-border: var(--border);
    --color-brand-500: var(--brand-500);

    background: var(--background-secondary);
    min-height: 100vh;
    padding-left: 1rem;
    padding-right: 1rem;
    color: var(--foreground);
    font-family: 'Manrope Variable', Manrope, system-ui, -apple-system, sans-serif;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  /* Toolbar */
  .cv-toolbar {
    max-width: 820px;
    margin: 0 auto 16px;
    display: flex;
    justify-content: flex-end;
  }
  .cv-print-btn {
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: oklch(100% 0 0);
    background: var(--brand-500);
    border: none;
    padding: 10px 20px;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
    box-shadow: 0 1px 2px oklch(20% 0.05 274 / 0.08);
  }
  .cv-print-btn:hover { background: var(--brand-600); }
  .cv-print-btn:active { transform: translateY(1px); }

  /* La feuille — proportions A4 fidèles (1 page) */
  .cv-sheet {
    max-width: 820px;
    margin: 0 auto;
    background: var(--background);
    padding: 30px 42px 24px;
    border-radius: 8px;
    border: 1px solid var(--border);
    box-shadow: 0 18px 50px oklch(20% 0.05 274 / 0.08), 0 4px 12px oklch(20% 0.05 274 / 0.04);
    position: relative;
    font-size: 11.5px;
    line-height: 1.4;
  }
  .cv-sheet::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: var(--brand-500);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
  }

  /* Header */
  .cv-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }
  .cv-identity { flex: 1; }
  .cv-name {
    font-family: 'Outfit Variable', Outfit, system-ui, -apple-system, sans-serif;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--foreground);
    margin: 0;
  }
  .cv-role {
    font-size: 13px;
    font-weight: 600;
    color: var(--brand-600);
    margin: 5px 0 0;
  }
  .cv-summary {
    font-size: 11.5px;
    color: var(--foreground-muted);
    margin: 7px 0 0;
    max-width: 58ch;
    line-height: 1.45;
  }

  /* Photo */
  .cv-photo {
    width: 92px;
    height: 112px;
    flex-shrink: 0;
    border-radius: 6px;
    object-fit: cover;
    display: block;
    border: 1px solid var(--border);
  }
  .cv-photo-placeholder {
    border: 1.5px dashed var(--border-strong);
    background: var(--background-secondary);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 9px;
    line-height: 1.4;
    color: var(--foreground-subtle);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    gap: 2px;
  }
  .cv-photo-hint {
    font-size: 7.5px;
    margin-top: 3px;
    text-transform: none;
    letter-spacing: 0.02em;
    opacity: 0.7;
  }

  /* Contact strip */
  .cv-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 3px 18px;
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px;
    padding: 10px 0 3px;
    color: var(--foreground-muted);
  }
  .cv-contact a {
    color: var(--foreground);
    text-decoration: none;
    border-bottom: 1px solid var(--brand-100);
    transition: border-color 0.2s, color 0.2s;
  }
  .cv-contact a:hover {
    border-color: var(--brand-500);
    color: var(--brand-600);
  }
  .cv-label { color: var(--foreground-subtle); }
  .cv-meta {
    font-size: 10.5px;
    color: var(--foreground-muted);
    padding-top: 5px;
    margin: 0;
  }
  .cv-meta strong { color: var(--foreground); font-weight: 600; }

  /* Sections */
  .cv-section { margin-top: 11px; }
  .cv-section h2 {
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: var(--foreground);
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 5px;
  }
  .cv-section h2::before {
    /* Caractère Unicode ■ au lieu d'un div avec background-color :
       imprimable sur tous les navigateurs (les background ne s'impriment
       pas par défaut en print). */
    content: "■";
    color: var(--brand-500);
    font-size: 11px;
    line-height: 1;
    flex-shrink: 0;
  }
  .cv-section h2::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  /* Skills */
  .cv-skill-row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 4px 16px;
    font-size: 11.5px;
    padding: 2px 0;
  }
  .cv-skill-row + .cv-skill-row { border-top: 1px solid var(--brand-100); }
  .cv-skill-cat {
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    font-weight: 600;
    color: var(--brand-600);
    padding-top: 1px;
  }
  .cv-skill-val { color: var(--foreground); }

  /* Projects */
  .cv-project { margin-bottom: 7px; }
  .cv-project:last-child { margin-bottom: 0; }
  .cv-project-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .cv-project-title {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--foreground);
  }
  .cv-project-title a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1.5px solid var(--brand-500);
    transition: color 0.2s;
  }
  .cv-project-title a:hover { color: var(--brand-600); }
  .cv-stack {
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 9.5px;
    color: var(--foreground-muted);
  }
  .cv-project-period {
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    color: var(--brand-600);
    font-weight: 600;
    margin-top: 2px;
    letter-spacing: 0.02em;
  }
  .cv-project-desc {
    font-size: 11px;
    color: var(--foreground-muted);
    margin: 2px 0 0;
    line-height: 1.45;
  }

  /* Experience */
  .cv-experience { margin-bottom: 4px; }
  .cv-job-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .cv-job-org { font-size: 12.5px; font-weight: 600; color: var(--foreground); }
  .cv-job-role { font-size: 11.5px; color: var(--brand-600); font-weight: 500; }
  .cv-job-date {
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 9.5px;
    color: var(--foreground-muted);
    text-align: right;
    max-width: 60%;
    line-height: 1.4;
  }
  ul.cv-tasks {
    list-style: none;
    margin: 4px 0 4px;
    padding: 0;
  }
  ul.cv-tasks li {
    position: relative;
    padding-left: 14px;
    font-size: 11px;
    color: var(--foreground-muted);
    margin-bottom: 0;
    line-height: 1.35;
  }
  ul.cv-tasks li::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: var(--brand-500);
    font-size: 10px;
  }
  .cv-env {
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 9.5px;
    color: var(--brand-700);
    background: var(--brand-50);
    display: inline-block;
    padding: 2px 7px;
    border-radius: 4px;
    border: 1px solid var(--brand-100);
  }

  /* Education / certs */
  .cv-entry {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 10px;
    font-size: 11.5px;
    padding: 2px 0;
  }
  .cv-entry + .cv-entry { border-top: 1px solid var(--brand-100); }
  .cv-entry-date {
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    color: var(--brand-600);
    font-weight: 600;
  }
  .cv-entry-body strong { color: var(--foreground); font-weight: 600; }
  .cv-entry-body span { color: var(--foreground-muted); display: block; font-size: 10.5px; }

  /* Interests */
  .cv-interests { font-size: 11px; color: var(--foreground-muted); }
  .cv-interests p { padding: 1px 0; margin: 0; }
  .cv-interests strong {
    color: var(--foreground);
    font-weight: 600;
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
  }

  /* ────────────────────────────────────────────────────────────────────────
     PRINT / PDF — sync avec l'écran
     Mêmes proportions, juste les chrome retirés. Pas de re-flow brutal.
  ──────────────────────────────────────────────────────────────────────── */
  @page { size: A4; margin: 0; }

  @media print {
    /* Force l'impression des couleurs partout — Firefox/Chrome n'imprime
       pas les couleurs (text, background) par défaut. Les `!important`
       sont nécessaires car certains navigateurs ignorent la cascade en print. */
    *,
    *::before,
    *::after {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
      color-adjust: exact !important;
    }

    html, body { background: #fff !important; }

    /* Fallback HEX pour les couleurs brand — oklch() est parfois mal rendu
       en print sur Firefox/Chrome. Indigo profond (signature CV). */
    .cv-page {
      --brand-50: #eef2ff !important;
      --brand-100: #e0e7ff !important;
      --brand-500: #4f46e5 !important;
      --brand-600: #4338ca !important;
      --brand-700: #3730a3 !important;
      --foreground: #1a2228 !important;
      --foreground-muted: #5a6670 !important;
      --foreground-subtle: #8a949c !important;
      --border: #e3e8eb !important;
    }

    header[data-menu-id],
    footer,
    .cv-toolbar { display: none !important; }

    [class*="z-50"]:not(.cv-sheet):not(.cv-sheet *) { display: none !important; }

    .cv-page {
      background: #fff !important;
      padding: 0;
      min-height: 0;
    }
    .cv-sheet {
      max-width: none;
      width: 100%;
      padding: 9mm 12mm 8mm;
      margin: 0;
      box-shadow: none !important;
      border: none !important;
      border-radius: 0 !important;
    }
    .cv-sheet::before { display: none; }
    .cv-photo-placeholder { border-color: #bbb; }
    .cv-page a { color: var(--foreground) !important; }

    /* Forcer la couleur indigo des éléments décoratifs en print */
    .cv-section h2::before,
    ul.cv-tasks li::before { color: #4f46e5 !important; }

    .cv-section,
    .cv-project,
    .cv-job-head,
    .cv-entry,
    ul.cv-tasks li { page-break-inside: avoid; }
  }
</style>
