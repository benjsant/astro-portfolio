---
/**
 * CV page - version ATS STRICTE
 * URL: /cv
 *
 * 1 colonne, texte à plat, HTML sémantique (h1/h2/p/ul), AUCUNE photo, aucune
 * grille ni tableau : parsing ATS maximal. Le pendant « design » (avec photo,
 * mise en page riche) est sur /cv-design.
 *
 * Toutes les données viennent de `src/data/cv.ts` (partagées avec /cv-design).
 * Pour modifier le contenu, édite ce fichier - pas le HTML/CSS ci-dessous.
 *
 * Anti-ATS évité : pas de `·` (converti en virgule), pas de tiret cadratin,
 * pas de colonnes. Téléchargement PDF via window.print() (`@page margin: 0`).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import CvContactValue from '@/components/patterns/CvContactValue.astro';
import { cv } from '@/data/cv';

// Anti-IA / anti-ATS : tiret cadratin/demi-cadratin (— –) -> trait d'union,
// point médian (·) -> virgule. Rend le texte parfaitement linéaire.
const clean = (s: string) => String(s ?? '').replace(/[—–]/g, '-').replace(/\s*·\s*/g, ', ');

// La disponibilité est mise en avant en haut (sous le titre) ; les autres
// infos (permis, mobilité) restent dans la ligne meta plus bas.
const recherche = cv.details.find((d) => d.label === 'Recherche');
const otherDetails = cv.details.filter((d) => d.label !== 'Recherche');
---

<BaseLayout
  title="CV_Benjamin_Santrisse"
  titleAsIs
  description={`Curriculum vitae de ${cv.header.name} - ${cv.header.role}. Version ATS, téléchargeable en PDF.`}
>
  <Header
    slot="header"
    position="fixed"
    shape="bar"
    variant="solid"
    size="lg"
    showCta={false}
  />

  <main class="cv-page pt-20 pb-12">
    <div class="cv-toolbar">
      <button type="button" class="cv-print-btn cv-print-btn--ghost" onclick="document.querySelector('.cv-sheet').classList.remove('cv-aere'); window.print();">
        ↓ PDF · 1 page (compact)
      </button>
      <button type="button" class="cv-print-btn" onclick="document.querySelector('.cv-sheet').classList.add('cv-aere'); window.print();">
        ↓ PDF · 2 pages (aéré)
      </button>
    </div>

    <article class="cv-sheet">
      <!-- HEADER -->
      <header class="cv-head">
        <h1 class="cv-name">{cv.header.name}</h1>
        <p class="cv-role">{cv.header.role}</p>
        {recherche && <p class="cv-avail">{clean(recherche.value)}</p>}
        <p class="cv-summary">{cv.header.summary}</p>

        <p class="cv-contact">
          {cv.contact.map((item, i) => (
            <Fragment>{i > 0 ? ' | ' : ''}<span class="cv-label">{item.label} :</span> <CvContactValue item={item} linkClass="cv-link" /></Fragment>
          ))}
        </p>
        {otherDetails.length > 0 && (
          <p class="cv-contact">
            {otherDetails.map((d, i) => (
              <Fragment>{i > 0 ? ' | ' : ''}<span class="cv-label">{d.label} :</span> {clean(d.value)}</Fragment>
            ))}
          </p>
        )}
      </header>

      <!-- COMPÉTENCES -->
      <section class="cv-section">
        <h2>Compétences</h2>
        {cv.skills.map((row) => (
          <p class="cv-line"><strong>{row.category} :</strong> {clean(row.value)}</p>
        ))}
      </section>

      <!-- PROJETS -->
      <section class="cv-section">
        <h2>Projets réalisés</h2>
        {cv.projects.map((project) => (
          <div class="cv-item">
            <p class="cv-item-head"><strong>{project.title}</strong>{project.period ? ` (${clean(project.period)})` : ''}</p>
            <p class="cv-item-tech">{clean(project.stack)}</p>
            <p class="cv-item-desc">{project.description}</p>
          </div>
        ))}
      </section>

      <!-- EXPÉRIENCES -->
      <section class="cv-section">
        <h2>Expériences professionnelles</h2>
        {cv.experiences.map((exp) => (
          <div class="cv-item">
            <p class="cv-item-head"><strong>{exp.org}</strong>, {exp.role}, {clean(exp.date)}</p>
            <ul class="cv-tasks">
              {exp.tasks.map((t) => <li>{t}</li>)}
            </ul>
            {exp.stack && <p class="cv-item-tech">Environnement : {clean(exp.stack)}</p>}
          </div>
        ))}
      </section>

      <!-- FORMATIONS -->
      <section class="cv-section">
        <h2>Formations</h2>
        {cv.education.map((entry) => (
          <p class="cv-line"><strong>{entry.title}</strong>, {entry.school} ({entry.date})</p>
        ))}
      </section>

      <!-- CERTIFICATIONS -->
      <section class="cv-section">
        <h2>Certifications</h2>
        {cv.certifications.map((c) => (
          <p class="cv-line"><strong>{c.title}</strong> ({c.date})</p>
        ))}
      </section>

      <!-- INTÉRÊTS -->
      <section class="cv-section">
        <h2>Centres d'intérêt</h2>
        {cv.interests.map((i) => (
          <p class="cv-line"><strong>{i.title}</strong> : {i.description}</p>
        ))}
      </section>
    </article>
  </main>
</BaseLayout>

<style is:global>
  /* ──────────────────────────────────────────────────────────────────────────
     CV ATS strict : 1 colonne, texte à plat, HTML sémantique, aucune photo.
     Couleur (indigo) purement visuelle : un ATS lit le TEXTE, pas les couleurs,
     donc on garde une identité sobre sans nuire au parsing. Écran = PDF.
  ────────────────────────────────────────────────────────────────────────── */

  .cv-page {
    --background: oklch(100% 0 0);
    --background-secondary: oklch(97.5% 0.010 190);
    --foreground: oklch(16% 0.01 250);
    --foreground-muted: oklch(31% 0.013 250);
    --border: oklch(88% 0.006 220);

    /* Indigo signature du CV (distinct du teal du portfolio). */
    --brand-500: oklch(53% 0.22 274);
    --brand-700: oklch(38% 0.17 274);

    background: var(--background-secondary);
    min-height: 100vh;
    padding-left: 1rem;
    padding-right: 1rem;
    color: var(--foreground);
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    line-height: 1.47;
    -webkit-font-smoothing: antialiased;
  }

  /* Toolbar (UI seulement, masquée en print) */
  .cv-toolbar {
    max-width: 820px;
    margin: 0 auto 16px;
    display: flex;
    justify-content: flex-end;
    gap: 10px;
  }
  .cv-print-btn--ghost {
    background: #fff;
    color: var(--brand-700);
    border: 1.5px solid oklch(93% 0.045 274);
    box-shadow: none;
  }
  .cv-print-btn--ghost:hover { background: oklch(97% 0.02 274); }
  .cv-print-btn {
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: oklch(100% 0 0);
    background: var(--brand-500);
    border: none;
    padding: 10px 20px;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
  }
  .cv-print-btn:hover { background: var(--brand-700); }
  .cv-print-btn:active { transform: translateY(1px); }

  /* La feuille - proportions A4 fidèles (1 page) */
  .cv-sheet {
    max-width: 820px;
    margin: 0 auto;
    background: var(--background);
    padding: 30px 42px 26px;
    border-radius: 8px;
    border: 1px solid var(--border);
    box-shadow: 0 18px 50px oklch(20% 0.05 274 / 0.08), 0 4px 12px oklch(20% 0.05 274 / 0.04);
    color: var(--foreground);
    font-size: 12px;
    line-height: 1.47;
  }

  /* Header : bloc texte pur, aucune colonne, aucune photo */
  .cv-head { padding-bottom: 4px; }
  .cv-name {
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.05;
    color: var(--foreground);
    margin: 0;
  }
  .cv-role {
    font-size: 15px;
    font-weight: 700;
    color: var(--brand-700);
    margin: 3px 0 0;
  }
  .cv-avail {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--foreground);
    margin: 4px 0 0;
  }
  .cv-avail::before {
    content: "●";
    color: #16a34a;
    margin-right: 6px;
    font-size: 9px;
    vertical-align: middle;
  }
  .cv-summary {
    font-size: 12px;
    color: var(--foreground-muted);
    margin: 6px 0 0;
    line-height: 1.47;
  }
  /* Contacts : lignes de texte à plat, séparateur sobre " | " */
  .cv-contact {
    font-size: 11.5px;
    color: var(--foreground-muted);
    margin: 5px 0 0;
    line-height: 1.5;
  }
  .cv-label { color: var(--foreground); font-weight: 700; }
  .cv-link {
    color: var(--foreground);
    text-decoration: none;
    border-bottom: 1px solid oklch(93% 0.045 274);
  }
  .cv-link:hover { color: var(--brand-700); border-color: var(--brand-500); }

  /* Sections : titre standard souligné, contenu à plat */
  .cv-section { margin-top: 11px; }
  .cv-section h2 {
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--brand-700);
    border-bottom: 1.5px solid oklch(90% 0.05 274);
    padding-bottom: 2px;
    margin: 0 0 6px;
  }

  .cv-line { font-size: 12px; color: var(--foreground-muted); margin: 3px 0; line-height: 1.47; }
  .cv-line strong { color: var(--foreground); }

  .cv-item { margin-bottom: 7px; }
  .cv-item:last-child { margin-bottom: 0; }
  .cv-item-head { font-size: 12.5px; color: var(--foreground); margin: 0; }
  .cv-item-head strong { color: var(--foreground); }
  .cv-item-tech { font-size: 11px; color: var(--foreground-muted); margin: 1px 0 0; }
  .cv-item-desc { font-size: 11.5px; color: var(--foreground-muted); margin: 1px 0 0; line-height: 1.47; }

  ul.cv-tasks { margin: 3px 0; padding-left: 18px; }
  ul.cv-tasks li { font-size: 11.5px; color: var(--foreground-muted); line-height: 1.4; margin: 0; }

  /* ── Mode AÉRÉ (bouton « 2 pages ») : respiration en plus ─────────────── */
  .cv-aere .cv-section { margin-top: 20px; }
  .cv-aere .cv-section h2 { margin-bottom: 10px; }
  .cv-aere .cv-summary { line-height: 1.6; }
  .cv-aere .cv-line { margin: 6px 0; line-height: 1.6; }
  .cv-aere .cv-item { margin-bottom: 14px; }
  .cv-aere .cv-item-desc { line-height: 1.6; }
  .cv-aere ul.cv-tasks li { margin-bottom: 4px; line-height: 1.55; }

  /* ────────────────────────────────────────────────────────────────────────
     PRINT / PDF - mêmes proportions, chrome retiré.
  ──────────────────────────────────────────────────────────────────────── */
  @page { size: A4; margin: 0; }

  @media print {
    *, *::before, *::after {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
      color-adjust: exact !important;
    }

    html, body { background: #fff !important; }

    /* Fallback HEX (oklch parfois mal rendu en print sur Firefox/Chrome). */
    .cv-page {
      --brand-500: #4f46e5 !important;
      --brand-700: #3730a3 !important;
      --foreground: #111619 !important;
      --foreground-muted: #333b42 !important;
      --border: #dfe4e8 !important;
    }

    header[data-menu-id],
    footer,
    .cv-toolbar { display: none !important; }

    [class*="z-50"]:not(.cv-sheet):not(.cv-sheet *) { display: none !important; }

    .cv-page { background: #fff !important; padding: 0; min-height: 0; }
    .cv-sheet {
      max-width: none;
      width: 100%;
      padding: 10mm 14mm 8mm;
      margin: 0;
      box-shadow: none !important;
      border: none !important;
      border-radius: 0 !important;
    }
    .cv-page a { color: var(--foreground) !important; }

    .cv-section,
    .cv-item,
    .cv-line,
    ul.cv-tasks li { page-break-inside: avoid; }
  }
</style>
