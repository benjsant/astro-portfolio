---
/**
 * CV Leclerc - variante ATS (page cachée, non liée dans la navigation).
 * URL: /cv-leclerc-ats
 *
 * Règles ATS : 1 colonne, aucun tableau/flottant, aucune icône/photo, noir sur
 * blanc, police standard, texte sélectionnable, coordonnées dans le corps.
 * Ordre : coordonnées, accroche, expérience, compétences, formation, intérêts.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import EmailLink from '@/components/patterns/EmailLink.astro';
import { cvLeclerc as cv } from '@/data/cv-leclerc';
---

<BaseLayout title="CV_Benjamin_Santrisse_Leclerc_ats" titleAsIs description="Curriculum vitae - employé commercial rayon bazar technique et culturel.">
  <Header slot="header" position="fixed" shape="bar" variant="solid" size="lg" showCta={false} />

  <main class="lc-page pt-20 pb-12">
    <div class="lc-toolbar no-print">
      <button type="button" class="lc-btn" onclick="window.print();">↓ Télécharger en PDF</button>
    </div>

    <article class="lc-sheet">
      <header>
        <h1 class="lc-name">{cv.header.name}</h1>
        <p class="lc-role">{cv.header.role}</p>
        <p class="lc-contact">
          {cv.contact.ville} | Téléphone : {cv.phone} | Email : <EmailLink user="santrissebenjamin" domain="gmail.com" linkClass="lc-link" />
        </p>
        <p class="lc-contact">{cv.contact.permis} | {cv.contact.dispo}</p>
      </header>

      <section>
        <h2>Profil</h2>
        <p class="lc-p">{cv.header.summary}</p>
      </section>

      <section>
        <h2>Expérience professionnelle</h2>
        {cv.experiences.map((e) => (
          <div class="lc-item">
            <p class="lc-item-head"><strong>{e.org}</strong>{e.role ? `, ${e.role}` : ''}, {e.date}</p>
            <ul>{e.tasks.map((t) => <li>{t}</li>)}</ul>
          </div>
        ))}
      </section>

      <section>
        <h2>Compétences</h2>
        {cv.atouts.map((a) => (
          <p class="lc-p"><strong>{a.title} :</strong> {a.text}</p>
        ))}
      </section>

      <section>
        <h2>Formation</h2>
        {cv.education.map((ed) => (
          <p class="lc-p"><strong>{ed.title}</strong>{ed.detail ? ` (${ed.detail})` : ''}, {ed.school}, {ed.date}</p>
        ))}
      </section>

      <section>
        <h2>Centres d'intérêt</h2>
        {cv.interests.map((i) => (
          <p class="lc-p"><strong>{i.title}</strong>{i.description ? ` : ${i.description}` : ''}</p>
        ))}
      </section>
    </article>
  </main>
</BaseLayout>

<style is:global>
  /* CV ATS Leclerc : noir sur blanc strict, 1 colonne, police standard. */
  .lc-page {
    background: #f3f4f6;
    min-height: 100vh;
    padding-left: 1rem;
    padding-right: 1rem;
    color: #000;
    font-family: Calibri, Carlito, Arial, Helvetica, system-ui, sans-serif;
    line-height: 1.4;
  }
  .lc-toolbar { max-width: 820px; margin: 0 auto 16px; display: flex; justify-content: flex-end; }
  .lc-btn {
    font-size: 13px; font-weight: 600; color: #fff; background: #111827;
    border: none; padding: 10px 20px; border-radius: 6px; cursor: pointer;
  }
  .lc-btn:hover { background: #374151; }

  .lc-sheet {
    max-width: 820px; margin: 0 auto; background: #fff; color: #000;
    padding: 30px 42px; border-radius: 8px; border: 1px solid #e5e7eb;
    font-size: 12.5px; line-height: 1.45;
  }
  .lc-name { font-size: 26px; font-weight: 700; margin: 0; }
  .lc-role { font-size: 15px; font-weight: 600; margin: 2px 0 8px; }
  .lc-contact { font-size: 12px; margin: 2px 0; }
  .lc-link { color: #000; text-decoration: underline; }

  .lc-sheet section { margin-top: 14px; }
  .lc-sheet h2 {
    font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;
    border-bottom: 1px solid #000; padding-bottom: 2px; margin: 0 0 6px;
  }
  .lc-p { margin: 4px 0; }
  .lc-item { margin-bottom: 8px; }
  .lc-item-head { margin: 0; }
  .lc-sheet ul { margin: 3px 0; padding-left: 18px; }
  .lc-sheet li { margin: 1px 0; }

  @page { size: A4; margin: 0; }
  @media print {
    html, body { background: #fff !important; }
    header[data-menu-id], footer, .lc-toolbar, .no-print { display: none !important; }
    [class*="z-50"]:not(.lc-sheet):not(.lc-sheet *) { display: none !important; }
    .lc-page { background: #fff !important; padding: 0; min-height: 0; }
    .lc-sheet {
      max-width: none; width: 100%; padding: 12mm 16mm; margin: 0;
      border: none !important; border-radius: 0 !important;
    }
    .lc-sheet section, .lc-item, li { page-break-inside: avoid; }
  }
</style>
