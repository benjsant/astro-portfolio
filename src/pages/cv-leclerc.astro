---
/**
 * CV Leclerc - variante DESIGN (page cachée, non liée dans la navigation).
 * URL: /cv-leclerc
 *
 * Réutilise le langage visuel du CV technique (en-tête encadré, pastilles de
 * section + filet, crochets d'angle, badge, frise formations) MAIS :
 *  - police proportionnelle partout (aucune chasse fixe = marqueur "dev")
 *  - aucune étiquette de technologie
 *  - accent indigo en traits/texte seulement (photocopie N&B correcte)
 * Le CV technique (/cv, /cv-design) n'est pas modifié.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import EmailLink from '@/components/patterns/EmailLink.astro';
import { cvLeclerc as cv } from '@/data/cv-leclerc';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

const photoExists = existsSync(join(process.cwd(), 'public', 'photo.jpg'));
---

<BaseLayout title="CV_Benjamin_Santrisse_Leclerc" titleAsIs description="Curriculum vitae - employé commercial rayon bazar technique et culturel.">
  <Header slot="header" position="fixed" shape="bar" variant="solid" size="lg" showCta={false} />

  <main class="lcd-page pt-20 pb-12">
    <div class="lcd-toolbar no-print">
      <button type="button" class="lcd-btn" onclick="window.print();">↓ Télécharger en PDF</button>
    </div>

    <article class="lcd-sheet">
      <!-- En-tête encadré -->
      <header class="lcd-head">
        <div class="lcd-head-text">
          <span class="lcd-avail"><span class="lcd-dot"></span>{cv.header.available}</span>
          <h1 class="lcd-name">{cv.header.name}</h1>
          <p class="lcd-role">{cv.header.role}</p>
          <p class="lcd-summary">{cv.header.summary}</p>
          <div class="lcd-contact">
            <span>{cv.contact.ville}</span>
            <span>Téléphone : {cv.phone}</span>
            <span>Email : <EmailLink user="santrissebenjamin" domain="gmail.com" linkClass="lcd-link" /></span>
            <span>{cv.contact.permis}</span>
            <span>{cv.contact.dispo}</span>
          </div>
        </div>
        {photoExists && (
          <img class="lcd-photo" src="/photo.jpg" alt={cv.header.name} width="96" height="116" />
        )}
      </header>

      <!-- Atouts pour le poste -->
      <section class="lcd-section">
        <h2 class="lcd-h2"><span class="lcd-sq"></span>Atouts pour le poste</h2>
        <div class="lcd-atouts">
          {cv.atouts.map((a) => (
            <div class="lcd-atout">
              <p class="lcd-atout-title">{a.title}</p>
              <p class="lcd-atout-text">{a.text}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Expériences professionnelles -->
      <section class="lcd-section">
        <h2 class="lcd-h2"><span class="lcd-sq"></span>Expériences professionnelles</h2>
        {cv.experiences.map((e) => (
          <div class="lcd-exp">
            <div class="lcd-exp-head">
              <span class="lcd-exp-org">{e.org}{e.role ? ` — ${e.role}` : ''}</span>
              <span class="lcd-exp-date">{e.date}</span>
            </div>
            <ul class="lcd-tasks">{e.tasks.map((t) => <li>{t}</li>)}</ul>
          </div>
        ))}
      </section>

      <!-- Formations (frise à pastilles) -->
      <section class="lcd-section">
        <h2 class="lcd-h2"><span class="lcd-sq"></span>Formations</h2>
        <div class="lcd-timeline">
          {cv.education.map((ed) => (
            <div class="lcd-tl-item">
              <span class="lcd-tl-org">{ed.title}{ed.detail ? ` (${ed.detail})` : ''}</span>
              <span class="lcd-tl-school">{ed.school} · {ed.date}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Centres d'intérêt -->
      <section class="lcd-section">
        <h2 class="lcd-h2"><span class="lcd-sq"></span>Centres d'intérêt</h2>
        {cv.interests.map((i) => (
          <p class="lcd-mini"><strong>{i.title}</strong>{i.description ? ` — ${i.description}` : ''}</p>
        ))}
      </section>

      <!-- Crochets d'angle décoratifs -->
      <span class="lcd-cor lcd-cor-tl"></span>
      <span class="lcd-cor lcd-cor-tr"></span>
      <span class="lcd-cor lcd-cor-bl"></span>
      <span class="lcd-cor lcd-cor-br"></span>
    </article>
  </main>
</BaseLayout>

<style is:global>
  /* CV Leclerc design : indigo en traits/texte, police proportionnelle, 1 page. */
  .lcd-page {
    --ind: #4f46e5; --ind-d: #3730a3; --fg: #111827; --mut: #374151; --bd: #d1d5db;
    background: #eef2ff; min-height: 100vh; padding-left: 1rem; padding-right: 1rem;
    color: var(--fg);
    font-family: 'Manrope Variable', Manrope, system-ui, -apple-system, 'Segoe UI', sans-serif;
    line-height: 1.45;
  }
  .lcd-toolbar { max-width: 820px; margin: 0 auto 16px; display: flex; justify-content: flex-end; }
  .lcd-btn {
    font-size: 13px; font-weight: 600; color: #fff; background: var(--ind);
    border: none; padding: 10px 20px; border-radius: 6px; cursor: pointer;
  }
  .lcd-btn:hover { background: var(--ind-d); }

  .lcd-sheet {
    position: relative; max-width: 820px; margin: 0 auto; background: #fff;
    padding: 32px 40px 26px; border-radius: 8px; border: 1px solid var(--bd);
    box-shadow: 0 12px 40px rgba(49, 46, 129, 0.08); font-size: 12px;
  }

  /* En-tête encadré */
  .lcd-head {
    display: flex; justify-content: space-between; align-items: flex-start; gap: 22px;
    border: 1.5px solid var(--ind); border-radius: 8px; padding: 16px 20px;
  }
  .lcd-head-text { flex: 1; }
  .lcd-avail { display: inline-flex; align-items: center; gap: 7px; font-size: 10.5px; font-weight: 700; letter-spacing: 0.08em; color: var(--ind-d); }
  .lcd-dot { width: 7px; height: 7px; border-radius: 50%; background: #16a34a; }
  .lcd-name { font-size: 27px; font-weight: 800; letter-spacing: -0.01em; margin: 6px 0 0; color: var(--fg); }
  .lcd-role { font-size: 14.5px; font-weight: 700; color: var(--ind-d); margin: 2px 0 0; }
  .lcd-summary { font-size: 12px; color: var(--mut); margin: 8px 0 0; line-height: 1.5; }
  .lcd-contact { display: flex; flex-wrap: wrap; gap: 3px 20px; margin: 10px 0 0; font-size: 11px; color: var(--mut); }
  .lcd-link { color: var(--ind-d); text-decoration: none; border-bottom: 1px solid var(--ind); }
  .lcd-photo { width: 92px; height: 112px; object-fit: cover; border-radius: 6px; border: 1.5px solid var(--ind); flex-shrink: 0; }

  /* Sections : pastille + titre + filet */
  .lcd-section { margin-top: 15px; }
  .lcd-h2 {
    display: flex; align-items: center; gap: 9px;
    font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--ind-d); margin: 0 0 8px; padding-bottom: 4px; border-bottom: 1.5px solid var(--ind);
  }
  .lcd-sq { width: 9px; height: 9px; background: var(--ind); border-radius: 2px; flex-shrink: 0; }

  /* Atouts en 2 colonnes */
  .lcd-atouts { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 24px; }
  .lcd-atout-title { font-size: 12.5px; font-weight: 700; color: var(--fg); margin: 0; }
  .lcd-atout-text { font-size: 11.5px; color: var(--mut); margin: 2px 0 0; line-height: 1.45; }

  /* Expériences */
  .lcd-exp { margin-bottom: 9px; }
  .lcd-exp-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .lcd-exp-org { font-size: 12.5px; font-weight: 700; color: var(--fg); }
  .lcd-exp-date { font-size: 11px; color: var(--mut); }
  .lcd-tasks { margin: 4px 0 0; padding-left: 18px; }
  .lcd-tasks li { font-size: 11.5px; color: var(--mut); margin: 1px 0; line-height: 1.4; }

  /* Formations - frise à pastilles */
  .lcd-timeline { display: flex; flex-direction: column; gap: 8px; padding-left: 16px; }
  .lcd-tl-item { position: relative; }
  .lcd-tl-item::before {
    content: ""; position: absolute; left: -16px; top: 4px; width: 8px; height: 8px;
    border-radius: 50%; background: #fff; border: 2px solid var(--ind);
  }
  .lcd-tl-org { display: block; font-size: 12.5px; font-weight: 700; color: var(--fg); }
  .lcd-tl-school { display: block; font-size: 11px; color: var(--mut); }

  .lcd-mini { font-size: 11.5px; color: var(--mut); margin: 3px 0; }
  .lcd-mini strong { color: var(--fg); }

  /* Crochets d'angle */
  .lcd-cor { position: absolute; width: 16px; height: 16px; border: 2px solid var(--ind); }
  .lcd-cor-tl { top: 10px; left: 10px; border-right: none; border-bottom: none; border-top-left-radius: 4px; }
  .lcd-cor-tr { top: 10px; right: 10px; border-left: none; border-bottom: none; border-top-right-radius: 4px; }
  .lcd-cor-bl { bottom: 10px; left: 10px; border-right: none; border-top: none; border-bottom-left-radius: 4px; }
  .lcd-cor-br { bottom: 10px; right: 10px; border-left: none; border-top: none; border-bottom-right-radius: 4px; }

  @page { size: A4; margin: 0; }
  @media print {
    *, *::before, *::after { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
    html, body { background: #fff !important; }
    header[data-menu-id], footer, .lcd-toolbar, .no-print { display: none !important; }
    [class*="z-50"]:not(.lcd-sheet):not(.lcd-sheet *) { display: none !important; }
    .lcd-page { background: #fff !important; padding: 0; min-height: 0; }
    .lcd-sheet {
      max-width: none; width: 100%; padding: 10mm 14mm 8mm; margin: 0;
      box-shadow: none !important; border: none !important; border-radius: 0 !important;
    }
    .lcd-section, .lcd-exp, .lcd-tl-item, .lcd-atout, li { page-break-inside: avoid; }
  }
</style>
