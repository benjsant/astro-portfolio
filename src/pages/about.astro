---
/**
 * About page
 * URL: /about
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { Hero } from '@/components/hero';
import TypingEffect from '@/components/ui/TypingEffect.astro';
import TechStack from '@/components/landing/TechStack.astro';
import LetterGlitchBand from '@/components/patterns/LetterGlitchBand.astro';
import siteConfig from '@/config/site.config';
---
<PageLayout
  title="À propos — Benjamin Santrisse, Développeur IA & Data"
  description="Développeur spécialisé en IA et Data Engineering. Certifié Développeur IA (RNCP Niv. 6, Simplon). Passionné par la chaîne complète : pipelines ML, APIs FastAPI, orchestration, LLMs."
>
  <Hero layout="centered" size="sm">
    <Badge slot="badge" variant="brand" pill>
      <Icon name="user" size="sm" />
      À propos
    </Badge>
    <h1 slot="title">
      <span class="text-foreground [-webkit-text-fill-color:currentColor]">Benjamin Santrisse —</span><br />
      <span class="text-brand-500 [-webkit-text-fill-color:var(--color-brand-500)]">
        <TypingEffect words={["Développeur IA", "Data Engineer", "ML Engineer", "Développeur Python", "Passionné de LLMs", "Disponible"]} />
      </span>
    </h1>
    <p slot="description">
      Je construis des systèmes IA concrets et déployables — de la donnée brute au modèle en production.
      Disponible pour de nouvelles opportunités.
    </p>
  </Hero>

  <!-- Profil -->
  <section class="py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-12 lg:grid-cols-2">
        <div class="flex flex-col gap-4" data-reveal="right">
          <div class="flex flex-col gap-6">
            <Badge variant="brand" pill class="self-start">Mon profil</Badge>
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
              Développeur IA<br />& Data Engineering
            </h2>
          </div>
          <p class="text-lg text-foreground-muted leading-relaxed">
            Spécialisé en Intelligence Artificielle et Data Engineering, je maîtrise la chaîne complète :
            collecte de données, entraînement de modèles, exposition via APIs FastAPI, et orchestration de pipelines avec Airflow.
          </p>
          <p class="text-lg text-foreground-muted leading-relaxed">
            Passionné par les LLMs et l'automatisation intelligente, je construis des outils concrets qui résolvent
            de vrais problèmes — pas des démos. Chaque projet que tu vois ici est fonctionnel et déployé.
          </p>
          <div class="flex gap-3 mt-2">
            <Button variant="outline" href={siteConfig.socialLinks[0]} target="_blank" rel="noopener noreferrer">
              <Icon name="brand-github" size="sm" />
              GitHub
            </Button>
            <Button variant="outline" href={siteConfig.socialLinks[1]} target="_blank" rel="noopener noreferrer">
              <Icon name="brand-linkedin" size="sm" />
              LinkedIn
            </Button>
          </div>
        </div>

        <div class="flex flex-col gap-4 h-full" data-reveal="left" data-reveal-delay="1">
          <Card variant="elevated" hover class="flex-1 flex flex-col justify-center">
            <div class="flex items-start gap-4">
              <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
                <Icon name="graduation-cap" size="md" />
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-xs font-bold tracking-wide text-foreground-muted mb-1">Certification RNCP Niveau 6 — Simplon, Lille</p>
                <h3 class="text-base font-semibold text-foreground">Développeur IA (2025–2026)</h3>
                <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                  Formation intensive : Python, ML/DL, MLOps, LLMs, FastAPI, Docker. Équivalent Bac+3/4.
                </p>
                <div class="flex flex-wrap gap-1.5 mt-3">
                  <Badge size="sm" variant="brand">Python</Badge>
                  <Badge size="sm" variant="brand">TensorFlow</Badge>
                  <Badge size="sm" variant="brand">MLflow</Badge>
                  <Badge size="sm" variant="brand">Airflow</Badge>
                </div>
              </div>
            </div>
          </Card>
          <Card variant="elevated" hover class="flex-1 flex flex-col justify-center">
            <div class="flex items-start gap-4">
              <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
                <Icon name="map-pin" size="md" />
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-xs font-bold tracking-wide text-foreground-muted mb-1">Localisation & mobilité</p>
                <h3 class="text-base font-semibold text-foreground">Marly — Métropole Valenciennoise</h3>
                <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                  Mobilité départementale (permis B + véhicule). Ouvert au remote total ou hybride.
                  Métropole Lilloise accessible.
                </p>
                <div class="flex flex-wrap gap-1.5 mt-3">
                  <Badge size="sm" variant="brand">Remote OK</Badge>
                  <Badge size="sm" variant="brand">Hybride OK</Badge>
                  <Badge size="sm" variant="brand">Présentiel Nord</Badge>
                </div>
              </div>
            </div>
          </Card>
        </div>
      </div>
    </div>
  </section>

  <!-- Ce que je fais -->
  <section class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-8 text-center flex flex-col items-center gap-4" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>Compétences</Badge>
          <h2 class="font-display text-4xl font-bold text-foreground">
            Ce que je maîtrise
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto text-balance">
          De la donnée brute au modèle en production — je couvre toute la chaîne.
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <Card hover data-reveal>
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="bot" size="md" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">IA & LLMs</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Intégration de LLMs (DeepSeek, Claude), RAG, agents IA, automatisation de workflows intelligents.
              </p>
            </div>
          </div>
        </Card>
        <Card hover data-reveal data-reveal-delay="1">
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="database" size="md" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Data Engineering</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Pipelines ETL, APIs FastAPI, PostgreSQL, MongoDB, orchestration Airflow.
              </p>
            </div>
          </div>
        </Card>
        <Card hover data-reveal data-reveal-delay="2">
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="flask-conical" size="md" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">MLOps & Déploiement</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Suivi d'expériences MLflow, conteneurisation Docker, CI/CD GitHub Actions, versionnage sémantique.
              </p>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- Stack -->
  <TechStack
    badge="Stack technique"
    title="Mes outils du quotidien"
    description="Les technologies que j'utilise pour construire des systèmes IA robustes et déployables."
    background="secondary"
  />

  <!-- Parcours -->
  <section class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>Parcours</Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            Formation & expérience
          </h2>
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <Card variant="elevated" padding="lg" data-reveal>
          <div class="flex items-center gap-3 pb-4 border-b border-border">
            <div class="w-11 h-11 rounded-lg bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="graduation-cap" size="md" />
            </div>
            <h3 class="font-display text-base font-semibold text-foreground">Formations</h3>
          </div>
          <div class="flex flex-col divide-y divide-border">
            <div class="py-4">
              <div class="flex items-baseline justify-between gap-2 mb-1">
                <p class="text-sm font-semibold text-foreground">Développeur IA — RNCP Niv. 6</p>
                <span class="text-xs text-foreground-muted shrink-0">2025 – 2026</span>
              </div>
              <p class="text-xs text-foreground-muted">Simplon, Lille · <span class="text-brand-500 font-medium">Certifié</span></p>
            </div>
            <div class="py-4">
              <div class="flex items-baseline justify-between gap-2 mb-1">
                <p class="text-sm font-semibold text-foreground">Licence Pro SIO — Option Développement</p>
                <span class="text-xs text-foreground-muted shrink-0">2018 – 2019</span>
              </div>
              <p class="text-xs text-foreground-muted">UVHC, Valenciennes</p>
            </div>
            <div class="py-4">
              <div class="flex items-baseline justify-between gap-2 mb-1">
                <p class="text-sm font-semibold text-foreground">BTS SIO — Option SLAM</p>
                <span class="text-xs text-foreground-muted shrink-0">2015 – 2017</span>
              </div>
              <p class="text-xs text-foreground-muted">Lycée Henri Wallon, Valenciennes</p>
            </div>
          </div>
        </Card>

        <Card variant="elevated" padding="lg" data-reveal data-reveal-delay="1">
          <div class="flex items-center gap-3 pb-4 border-b border-border">
            <div class="w-11 h-11 rounded-lg bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="briefcase" size="md" />
            </div>
            <h3 class="font-display text-base font-semibold text-foreground">Expérience</h3>
          </div>
          <div class="flex flex-col divide-y divide-border">
            <div class="py-4">
              <div class="flex items-baseline justify-between gap-2 mb-1">
                <p class="text-sm font-semibold text-foreground">Développeur Web Symfony</p>
                <span class="text-xs text-foreground-muted shrink-0">2016 – 2019</span>
              </div>
              <p class="text-xs text-foreground-muted mb-2">CAF du Nord, Valenciennes · Stages successifs (6 mois)</p>
              <ul class="text-xs text-foreground-muted space-y-1 list-disc list-inside">
                <li>Développement d'interfaces web avec Symfony et Bootstrap</li>
                <li>Plateforme de gestion des espaces de travail</li>
                <li>Stack : PHP, Symfony, Bootstrap, PostgreSQL, Git</li>
              </ul>
            </div>
            <div class="py-4">
              <div class="flex items-baseline justify-between gap-2 mb-1">
                <p class="text-sm font-semibold text-foreground">Certification Gestion de Projet Agile</p>
                <span class="text-xs text-foreground-muted shrink-0">2025</span>
              </div>
              <p class="text-xs text-foreground-muted">Méthodes agiles — certification professionnelle</p>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="glitch:hidden mx-auto max-w-2xl px-6 text-center" data-reveal>
      <Badge variant="brand" pill class="mb-6">Contact</Badge>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        Mon profil vous intéresse ?
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        Disponible immédiatement pour un poste en IA, Data Engineering ou ML Engineering.
        Parlons-en.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" href="/contact" class="cta-btn-brand">
          Me contacter
          <Icon name="arrow-right" size="sm" />
        </Button>
        <Button size="lg" variant="outline" href="/cv.pdf" target="_blank" rel="noopener noreferrer">
          <Icon name="download" size="sm" />
          Télécharger mon CV
        </Button>
      </div>
    </div>

    <LetterGlitchBand>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        Mon profil vous intéresse ?
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        Disponible immédiatement pour un poste en IA, Data Engineering ou ML Engineering.
        Parlons-en.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" href="/contact" class="hero-btn-brand">
          Me contacter
          <Icon name="arrow-right" size="sm" />
        </Button>
        <Button size="lg" variant="outline" href="/cv.pdf" target="_blank" rel="noopener noreferrer">
          <Icon name="download" size="sm" />
          Télécharger mon CV
        </Button>
      </div>
    </LetterGlitchBand>
  </section>
</PageLayout>

<style>
  details[open] > summary .faq-icon {
    transform: rotate(180deg);
  }
</style>
