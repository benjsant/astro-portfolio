---
/**
 * Rend la VALEUR d'un contact CV :
 *   - email  → <EmailLink> (obfusqué dans le HTML, mailto: activé au chargement)
 *   - lien   → <a> (target _blank si http ; tel: pour le téléphone privé)
 *   - sinon  → texte brut
 *
 * Le téléphone n'a pas d'obfuscation : il n'existe que dans les CV générés
 * en local (cf. `privatePhone()` dans src/data/cv.ts), jamais sur le site.
 *
 * Logique partagée par `/cv` et `/cv-design` (chacun fournit son propre
 * wrapper/style autour, ici on ne gère que la valeur).
 */
import EmailLink from './EmailLink.astro';
import { asEmailParts } from '@/lib/cv-utils';
import type { ContactItem } from '@/data/cv';

interface Props {
  item: ContactItem;
  /** Classe appliquée au lien/élément rendu. */
  linkClass?: string;
}

const { item, linkClass } = Astro.props;
const email = asEmailParts(item.value);
const isHttp = item.href?.startsWith('http');
---

{
  email ? (
    <EmailLink user={email.user} domain={email.domain} class={linkClass} />
  ) : item.href ? (
    <a
      href={item.href}
      target={isHttp ? '_blank' : undefined}
      rel={isHttp ? 'noopener noreferrer' : undefined}
      class={linkClass}
    >
      {item.value}
    </a>
  ) : (
    <span class={linkClass}>{item.value}</span>
  )
}
