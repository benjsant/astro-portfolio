# =============================================================================
# Portfolio Benjamin Santrisse — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# Variables prefixed with PUBLIC_ are exposed to the browser — NEVER prefix secrets

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Production site URL (used for sitemap, canonical URLs, OG images)
SITE_URL=https://benjamin-santrisse.vercel.app

# Deployment target — "vercel" pour Vercel, ou laisser vide pour Docker/Node dev
DEPLOY_TARGET=vercel

# -----------------------------------------------------------------------------
# Chat agent IA (DeepSeek)
# -----------------------------------------------------------------------------

# Clé API DeepSeek — obtenir sur https://platform.deepseek.com
# Sans cette clé, l'endpoint /api/chat retourne 503 (Service indisponible).
# Rate limit : 10 messages par IP par heure (configurable dans src/pages/api/chat.ts)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# -----------------------------------------------------------------------------
# Search Engine Verification (optional)
# -----------------------------------------------------------------------------

# Google Search Console verification code
# GOOGLE_SITE_VERIFICATION=your-verification-code

# Bing Webmaster Tools verification code
# BING_SITE_VERIFICATION=your-verification-code

# -----------------------------------------------------------------------------
# Analytics (optional — désactivé par défaut)
# -----------------------------------------------------------------------------

# Google Analytics 4 Measurement ID
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager Container ID
# PUBLIC_GTM_ID=GTM-XXXXXXX

# -----------------------------------------------------------------------------
# Consent / Privacy (optional — nécessaire si GA/GTM activés)
# -----------------------------------------------------------------------------

# PUBLIC_CONSENT_ENABLED=true
# PUBLIC_PRIVACY_POLICY_URL=/privacy

# -----------------------------------------------------------------------------
# Google Maps (optional — pas utilisé pour l'instant)
# -----------------------------------------------------------------------------

# PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
